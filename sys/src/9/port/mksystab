#!/bin/rc
# One architecture-aware number selection, shared with libc.
rc /sys/src/libc/9syscall/syscalls $objtype /sys/src/libc/9syscall/sys.h defines |
awk '
/^#define/ {
 name[n++]=$2
 h="sys" tolower($2)
 if($2=="SYSR1") h="sysr1"
 if($2 ~ /^_X[0-9]+$/) h="sysdeath"
 handler[n-1]=h
}
END {
 if(n==0) exit 1
 print "#include \"/sys/src/libc/9syscall/sys.h\""
 print "typedef uintptr Syscall(va_list);"
 print "Syscall sysdeath;"
 for(i=0;i<n;i++) if(!declared[handler[i]]++) print "Syscall " handler[i] ";"
 print "Syscall *systab[]={"
 for(i=0;i<n;i++) printf "\t[%s]\t%s,\n", name[i], handler[i]
 print "};\nchar *sysctab[]={"
 for(i=0;i<n;i++) {
  s=substr(name[i],1,1) tolower(substr(name[i],2))
  sub(/_$/, "", s)
  if(s=="Sysr1") s="Running"
  if(s=="Rendezvous") s="Rendez"
  printf "\t[%s]\t\"%s\",\n", name[i], s
 }
 print "};\nint nsyscall = sizeof systab/sizeof systab[0];"
}'
