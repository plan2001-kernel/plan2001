#!/bin/rc
# genall - generate the APE versions of the system call C interfaces.
#	must be invoked by mk so that the right env variables are set.
rfork e
# ugh. sources's build process can't hack absolute path names.
# we're in /sys/src/ape/lib/ap/syscall.
SYSH=../../../../libc/9syscall/sys.h	# /sys/src/libc/9syscall/sys.h

SYS=`{rc ./../../../../libc/9syscall/syscalls $objtype $SYSH | awk '$1 !~ /^_/ {print $1}'}
for(I in $SYS) {
	i=_^$I
	n=`{sed -n '/[ 	]'$I'[ 	]/s/.*	//p' $SYSH}
	if(~ $objtype wasm32){
		# no system call instruction: the platform's _trap, as libc's
		# stubs (/sys/src/libc/9syscall/mkfile)
		{
			echo 'typedef long long vlong;'
			echo 'extern vlong _trap(int, void*);'
			echo 'vlong'
			echo $i'(void *a)'
			echo '{'
			echo '	return _trap('$n', &a);'
			echo '}'
		} > $i.c
		$CC $CFLAGS $i.c
	}
	if not
		./gencall
}
if(! ~ $objtype wasm32){
	rm -f _SPAWN.$O _SPAWN.s
	if(ar t /$objtype/lib/ape/libap.a >[2]/dev/null | grep -s '^_SPAWN\.'^$O^'$')
		ar d /$objtype/lib/ape/libap.a _SPAWN.$O >[2]/dev/null
}
ar vu /$objtype/lib/ape/libap.a *.$O
if(~ $objtype wasm32) rm -f *.c
rm -f *.$O *.s
