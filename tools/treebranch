#!/bin/bash
# The tree branch: the machine's whole source, a snapshot - 9front's
# source at upstream/9front.lock's COMMIT (its files, from the upstream
# cache, tools/upstream; not its history: 9front's own is
# git.9front.org/plan9front/9front) assembled as tools/tree assembles it
# (tools/upstream assemble: the patch stack, this tree's new files,
# tools/prune-tree), without 9front's off-topic files (tools/dist.deny).
# Its root is the machine's /: the installer copies it with
# /dist/9front/.git, and bind -ac /dist/9front / makes / its work tree, as
# on 9front.  A commit a run when the source has changed, onto the
# branch's last (the first has none): a new upstream lock or a new main is
# one more snapshot.  Nothing in the work tree is touched (a worktree of
# its own, in build/).
#   tools/treebranch	[TREEMSG: more lines for the commit's message]
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
cd "$root"
. upstream/9front.lock
"$here/upstream" source >/dev/null
cache=${PLAN2001_CACHE:-$HOME/.cache/plan2001}/9front.git
git fetch -q --no-tags "$cache" "+refs/heads/$BRANCH:refs/9front/$BRANCH"
git cat-file -e "$COMMIT^{commit}" || { echo "treebranch: $COMMIT is not in $cache" >&2; exit 1; }
git update-ref refs/9front/front "$COMMIT"
base=$COMMIT
parent=$(git rev-parse -q --verify refs/heads/tree || true)
main=$(git rev-parse --short HEAD)
wt=$root/build/treebranch
git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
git worktree prune
git worktree add -q --detach "$wt" "$base"
trap 'git worktree remove --force "$wt" 2>/dev/null || true' EXIT
# this tree's patches and files over 9front's, as tools/tree lays them
"$here/upstream" assemble "$wt"
# 9front's off-topic files
(cd "$wt" && git ls-files) | python3 -I -c '
import re, sys
deny = [re.compile(l.strip()) for l in open(sys.argv[1]) if l.strip() and not l.startswith("#")]
for f in sys.stdin:
	f = f.rstrip("\n")
	if any(d.search("/" + f) for d in deny):
		print(f)
' "$here/dist.deny" | (cd "$wt" && xargs -r git rm -q --)
git -C "$wt" add -A
tree=$(git -C "$wt" write-tree)
if [ -n "$parent" ] && [ "$(git rev-parse "$parent^{tree}")" = "$tree" ]; then
	echo "treebranch: tree is $(git rev-parse --short "$parent"): no change"
	exit 0
fi
parents=()
[ -z "$parent" ] || parents=(-p "$parent")
msg="Plan2001 $main over 9front $(git rev-parse --short "$base")

The machine's source: 9front's (upstream/9front.lock: $COMMIT, build $BUILD) and Plan2001's
main $main over it (tools/treebranch), without 9front's off-topic files."
[ -z "${TREEMSG:-}" ] || msg="$msg

$TREEMSG"
c=$(git commit-tree "$tree" "${parents[@]}" -m "$msg")
git update-ref refs/heads/tree "$c"
echo "treebranch: tree is $(git rev-parse --short "$c") (over 9front's: $(git diff --shortstat "$base" "$c"))"
