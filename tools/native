#!/bin/bash
# Plan9-wasm32 built natively, with 9front's own mkfiles, as objtype=wasm32
# mk on a 9front machine builds it - here: the tree (tools/tree) as / ,
# plan9port's mk, rc and yacc ($PLAN9), the host's 3c and 3l
# (tools/hostcc), and an ar that takes Plan 9's "ar vu".  What it builds
# goes to the tree's /wasm32 (lib, bin) and /sys/src/9/wasm32.  DIRs that
# need others' libraries need those DIRs before them.
#   PLAN9=... tools/native [DIR[:TARGET,...]...]
#        DIRs under /sys/src, in order, each mk install or mk TARGETs
#        (default: the libraries, the kernel, the boot file system's programs)
#   TREE=dir: a tree already made, else build/tree made anew; MKFLAGS: mk's (-k)
#   NATIVE_WRAP: auto (default), direct, bwrap, proot or unshare.
#        bwrap: a mount namespace, no root needed (Linux).  proot: path
#        mapping, no namespaces (Termux/Android, where bwrap and unshare
#        are unavailable); it is not process isolation.  direct: the tree
#        already is this process's / (a real chroot/container).  unshare:
#        mount namespace, needs root or user namespaces.
#   The absolute /sys, /wasm32 and /lib paths in 9front's mkfiles are what
#   the bwrap/proot/direct choice maps; direct only works when they are
#   already the tree's.
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
[ -x "${PLAN9:-}/bin/mk" ] && [ -x "$PLAN9/bin/rc" ] || { echo "native: PLAN9 must name a plan9port with mk and rc" >&2; exit 2; }
# Use host tools for GNU options and regular expressions in build setup.
hostsed=sed
hostgrep=grep
hosttouch=touch
if ! sed --version >/dev/null 2>&1; then
	hostsed=/usr/bin/sed
	hostgrep=/usr/bin/grep
	hosttouch=/usr/bin/touch
fi
tree=${TREE:-$root/build/tree}
[ -n "${TREE:-}" ] || "$here/tree" "$tree" >/dev/null
tree=$(cd "$tree" && pwd)
"$here/hostcc/build" 3c 3l >/dev/null
bin=$root/build/host/bin
mkdir -p "$bin" "$tree/wasm32/lib" "$tree/wasm32/bin"
rm -f "$bin/pcc"
hostar=$(command -v ar || echo /usr/bin/ar)
cat >"$bin/ar" <<X
#!/bin/sh
# Plan 9's ar: its key may be implied (mksyslib's "ar vu LIB FILES": r)
k=\$1; shift
case \$k in *[dmpqrtx]*) ;; *) k=r\$k ;; esac
exec $hostar "\$k" "\$@"
X
chmod 775 "$bin/ar"
# size, which some mkfiles run on what they made (cwfs): Plan 9's says the
# segments; the host's knows no wasm32 module - its size in bytes instead
cat >"$bin/size" <<'X'
#!/bin/sh
for f; do echo "$f: $(wc -c <"$f") bytes"; done
X
chmod 775 "$bin/size"
rm -f "$bin/mk" "$bin/rc.mk"
# mpc (libsec's and libauthsrv's X.mp to C), a program for the host: the
# release ships its output for some, not libauthsrv's; built here with
# plan9port from the tree's mpc.y.  Its numbers are read with strtomp's
# base 0, which plan9port's libmp does not have (it read 39081 as hex):
# 9front's rule (0x, 0b, 0 octal, else decimal) in a helper
if [ -e "$tree/sys/src/cmd/mpc.y" ] && [ ! -x "$bin/mpc" ]; then
	m=$(mktemp -d)
	cp "$tree/sys/src/cmd/mpc.y" "$m/"
	"$hostsed" -i 's/strtomp(f->s->n, nil, 0, nil)/strtomp0(f->s->n)/; 0,/^#include[ \t]*<mp.h>/s//&\nstatic mpint *strtomp0(char*);/' "$m/mpc.y"
	cat >>"$m/mpc.y" <<'C'

static mpint*
strtomp0(char *a)
{
	int base;

	base = 10;
	if(a[0] == '0'){
		if(a[1] == 'x' || a[1] == 'X'){
			a += 2;
			base = 16;
		}else if(a[1] == 'b' || a[1] == 'B'){
			a += 2;
			base = 2;
		}else if(a[1] >= '0' && a[1] <= '7'){
			a++;
			base = 8;
		}
	}
	return strtomp(a, nil, base, nil);
}
C
	"$hostgrep" -q 'strtomp0(f->s->n)' "$m/mpc.y" && "$hostgrep" -q '^static mpint \*strtomp0(char\*);' "$m/mpc.y" || { echo "native: mpc.y: its strtomp is not where it was" >&2; exit 1; }
	(cd "$m" && PATH=$PLAN9/bin:$PATH "$PLAN9/bin/yacc" -d mpc.y >/dev/null &&
		PATH=$PLAN9/bin:$PATH 9c y.tab.c && PATH=$PLAN9/bin:$PATH 9l -o "$bin/mpc" y.tab.o) || { echo "native: mpc" >&2; exit 1; }
	rm -rf "$m"
fi
# cpp, for cc -p (3c runs $CPP): 9front's, built for the host with plan9port's lib9
if [ -e "$tree/sys/src/cmd/cpp/cpp.c" ] && [ ! -x "$bin/cpp" ]; then
	m=$(mktemp -d)
	cp "$tree"/sys/src/cmd/cpp/*.[ch] "$m/"
	# bionic's stdio.h includes fcntl.h/unistd.h; include it before
	# plan9port's libc.h macros rename open/creat/dup to p9open/...
	python3 - "$m"/*.c <<'PY'
import sys
for p in sys.argv[1:]:
	s = open(p).read()
	s = s.replace('#include <u.h>\n#include <libc.h>\n#include <stdio.h>\n',
		'#include <u.h>\n#include <stdio.h>\n#include <libc.h>\n')
	open(p, 'w').write(s)
PY
	"$hostsed" -i 's/^extern[ \t]*int getopt(int, char \*\*, char \*);//' "$m/nlist.c"	# POSIX's getopt is declared already
	gcc -O2 -w -fcommon -Wno-int-conversion -I"$PLAN9/include" -o "$bin/cpp" "$m"/*.c -L"$PLAN9/lib" -l9 -lm ||
		{ echo "native: cpp" >&2; exit 1; }
	rm -rf "$m"
fi
# aux/kbdfs's latin1.h, made from /lib/keyboard by mklatin, a program for
# the host: the release does not ship it; made here with plan9port.
# The released mklatin's Trie.seq[MAXLD+1] only fits two-key sequences,
# but /lib/keyboard contains longer sequences.  Its unchecked strcpy
# overflows the trie for those entries.  kbdfs's latin1 table supports
# only MAXLD=2; skip longer sequences in this HOST generator copy.
k=$tree/sys/src/cmd/aux/kbdfs
if [ -e "$k/mklatin.c" ] && [ ! -e "$k/latin1.h" ]; then
	m=$(mktemp -d)
	cp "$k/mklatin.c" "$m/mklatin.c"
	python3 - "$m/mklatin.c" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
old = 'if(inseq && p-seq >= 2) {'
new = 'if(inseq && p-seq >= 2 && p-seq <= MAXLD) {'
if s.count(old) != 1:
    raise SystemExit('native: unexpected upstream mklatin.c; review bounds guard')
open(p, 'w').write(s.replace(old, new))
PY
	(cd "$m" && PATH=$PLAN9/bin:$PATH 9c mklatin.c && PATH=$PLAN9/bin:$PATH 9l -o mklatin mklatin.o &&
		./mklatin "$tree/lib/keyboard" >"$k/latin1.h") || { echo "native: latin1.h" >&2; rm -f "$k/latin1.h"; exit 1; }
	rm -rf "$m"
fi
# What 9front's mkfiles make with a program for the host ($cputype) - its
# own release ships them made, its source does not: libc/ucd's tables
# (mkrunetype, from /lib/ucd's text), awk's proctab.c (maketab, from
# yacc's y.tab.h) and jpg's ycbcr.h and rgbv.h (rgbycc, rgbrgbv).  Made
# here with plan9port's 9c and 9l from the tree's own programs.
hostmade() {	# DIR PROGRAM: build DIR/PROGRAM.c for the host into $m/PROGRAM
	cp "$1/$2.c" "$m/$2.c" && (cd "$m" && PATH=$PLAN9/bin:$PATH 9c "$2.c" >/dev/null && PATH=$PLAN9/bin:$PATH 9l -o "$2" "$2.o")
}
u=$tree/sys/src/libc/ucd
if [ -e "$u/mkrunetype.c" ] && [ ! -e "$u/runeistypedata" ]; then
	m=$(mktemp -d)
	cp "$u/mkrunetype.c" "$m/mkrunetype.c"
	"$hostsed" -i "s|\"/lib/ucd/|\"$tree/lib/ucd/|" "$m/mkrunetype.c"
	"$hostgrep" -q "\"$tree/lib/ucd/UnicodeData.txt\"" "$m/mkrunetype.c" || { echo "native: mkrunetype.c: its /lib/ucd is not where it was" >&2; exit 1; }
	(cd "$m" && PATH=$PLAN9/bin:$PATH 9c mkrunetype.c >/dev/null && PATH=$PLAN9/bin:$PATH 9l -o mkrunetype mkrunetype.o &&
		cd "$u" && "$m/mkrunetype") || { echo "native: libc/ucd's tables" >&2; rm -f "$u"/rune*data; exit 1; }
	rm -rf "$m"
fi
aw=$tree/sys/src/cmd/awk
if [ -e "$aw/awkgram.y" ] && [ ! -e "$aw/y.tab.h" ]; then
	(cd "$aw" && "$PLAN9/bin/yacc" -d -o awkgram.c awkgram.y >/dev/null 2>&1) || { echo "native: awk's grammar" >&2; exit 1; }
fi
if [ -e "$aw/maketab.c" ] && [ ! -e "$aw/proctab.c" ]; then
	m=$(mktemp -d)
	(hostmade "$aw" maketab && cd "$aw" && "$m/maketab" >proctab.c) || { echo "native: awk's proctab.c" >&2; rm -f "$aw/proctab.c"; exit 1; }
	rm -rf "$m"
fi
j=$tree/sys/src/cmd/jpg
if [ -e "$j/rgbycc.c" ] && { [ ! -e "$j/ycbcr.h" ] || [ ! -e "$j/rgbv.h" ]; }; then
	m=$(mktemp -d)
	(hostmade "$j" rgbycc && hostmade "$j" rgbrgbv && "$m/rgbycc" >"$j/ycbcr.h" && "$m/rgbrgbv" >"$j/rgbv.h") ||
		{ echo "native: jpg's ycbcr.h, rgbv.h" >&2; rm -f "$j/ycbcr.h" "$j/rgbv.h"; exit 1; }
	rm -rf "$m"
fi
# what the kernel and the boot file system's programs need, in order, and
# those programs (sys/src/9/wasm32/bootfs.proto)
libs="libc libthread libmp libsec libbio libregexp libString libauth libauthsrv lib9p libip libndb libdraw libmemdraw libmemlayer libframe libcomplete libplumb libcontrol libflate libdisk libavl libjson libwebauthn"
one="basename cat cleanname cp date dd echo ls mkdir mv rm sleep sort touch wc xd bind unmount ns sed mount pwd ps read test chmod tlsclient mntgen ramfs tar stats webcookies clock srv"
cmds="cmd/rc cmd/hjfs cmd/rio cmd/aux/kbdfs cmd/auth/factotum cmd/auth/secstore:secstore.install,aescbc.install cmd/aux/seckeys cmd/exportfs cmd/plumb cmd/disk/prep cmd/disk:format.install,mkfs.install,mkext.install cmd/dossrv cmd/9660srv cmd/gefs cmd/cwfs cmd/gzip:gunzip.install cmd/webfs cmd/ip/ipconfig cmd/ip:ping.install cmd/ndb:cs.install cmd/aux:listen1.install,dial.install cmd/ethergw cmd/jsio cmd:$(echo $one | "$hostsed" 's/\([^ ]*\)/\1.install/g; s/ /,/g')"
dirs=${*:-$libs 9/wasm32 $cmds}
# /lib/ucd: libc/ucd's tables are made from it (above, by the host's
# mkrunetype); stand-ins older than the tables.  aux/kbdfs's latin1.h, made from
# /lib/keyboard by mklatin, a program for the host ($cputype): it comes made
# too; a stand-in /lib/keyboard as old (below, a stand-in mklatin)
ucd=$(mktemp -d)
trap 'rm -rf "$ucd"' EXIT
for f in CompositionExclusions DerivedNormalizationProps GraphemeBreakProperty UnicodeData WordBreakProperty emoji-data; do
	"$hosttouch" -d 1980-01-01 "$ucd/$f.txt"	# not 0: mk takes that as no file
done
"$hosttouch" -d 1980-01-01 "$ucd/keyboard"
# the tree's 9front root in a mount namespace of the build's own: with bwrap
# a root of its own (the host's directories, the tree's /sys and every
# /$objtype it has: libmach includes /arm/include/ureg.h ...), no root
# needed; else unshare, which needs /wasm32 made by root
wrap_mode=${NATIVE_WRAP:-auto}
if [ "$wrap_mode" = auto ]; then
	if command -v bwrap >/dev/null; then
		wrap_mode=bwrap
	elif command -v proot >/dev/null; then
		wrap_mode=proot
	else
		wrap_mode=unshare
	fi
fi
case $wrap_mode in
direct)
	# The tree is already this process's / (a real chroot or container):
	# no bwrap, unshare or path mapping is needed.
	wrap=()
	;;
bwrap)
	wrap=(bwrap --dev /dev --proc /proc --tmpfs /tmp)
	for d in /*; do
		n=${d#/}
		case $n in sys|proc|dev|tmp|lost+found) continue ;; esac
		[ -e "$tree/$n" ] && [ -d "$tree/$n" ] && [ ! -e "/$n" ] && continue	# the tree's, below
		if [ -L "$d" ]; then wrap+=(--symlink "$(readlink "$d")" "$d"); elif [ -d "$d" ]; then wrap+=(--bind "$d" "$d"); fi
	done
	# what the build wants of the host's / that is not there, over the
	# directory it would be in: /bin/rc, the interpreter of the source's
	# scripts (#!/bin/rc), plan9port's; /lib/ucd and
	# /lib/keyboard, the stand-ins (bound over the host's, below)
	ov=$ucd.over
	trap 'rm -rf "$ucd" "$ov"' EXIT
	while read -r f t; do
		[ ! -e "$f" ] || continue
		d=$(readlink -f "$(dirname "$f")")
		mkdir -p "$ov$d"
		ln -s "$t" "$ov$d/$(basename "$f")"
	done <<-Y
		/bin/rc $PLAN9/bin/rc
		/lib/ucd $ucd
		/lib/keyboard $ucd/keyboard
		/lib/face $tree/lib/face
	Y
	for d in $( [ ! -d "$ov" ] || (cd "$ov" && find . -type l -printf '%h\n' | sort -u) ); do
		d=${d#.}
		wrap+=(--overlay-src "$d" --overlay-src "$ov$d" --ro-overlay "$d")
	done
	# PLAN9 may be under /tmp, which the namespace replaces with a tmpfs.
	wrap+=(--bind "$PLAN9" "$PLAN9")
	wrap+=(--bind "$tree/sys" /sys --bind "$tree/rc" /rc --bind "$ucd" "$ucd")
	for d in "$tree"/*; do
		n=$(basename "$d")
		case $n in sys|lib|rc|usr|adm|tmp|mnt|n|dev|env|proc|fd|srv|net|bin) continue ;; esac
		[ -d "$d/include" ] || [ -d "$d/bin" ] || [ -d "$d/lib" ] || continue	# an /$objtype
		[ -e "/$n" ] && [ ! -L "/$n" ] && [ "$n" != wasm32 ] && continue
		wrap+=(--bind "$d" "/$n")
	done
	[ -e /lib/ucd ] && wrap+=(--bind "$ucd" /lib/ucd)
	[ -e /lib/keyboard ] && wrap+=(--bind "$ucd/keyboard" /lib/keyboard)
	[ -e /lib/face ] && wrap+=(--bind "$tree/lib/face" /lib/face)
	;;
proot)
	# Termux/Android: no user namespaces and no bwrap.  proot is not a
	# namespace: it rewrites path lookups in the child, which is what the
	# 9front mkfiles need for their absolute /sys, /wasm32 and /lib paths.
	ntmp=$(mktemp -d)
	trap 'rm -rf "$ucd" "$ntmp"' EXIT
	# Termux's termux-exec (LD_PRELOAD) rewrites execve paths and breaks
	# proot's bindings; the build inside proot does not need it.
	wrap=(env -u LD_PRELOAD proot -0 -r / -b "$ntmp:/tmp")
	wrap+=(-b "$tree/sys:/sys" -b "$tree/wasm32:/wasm32")
	[ ! -d "$tree/lib" ] || wrap+=(-b "$tree/lib:/lib")
	[ ! -d "$tree/rc" ] || wrap+=(-b "$tree/rc:/rc")
	wrap+=(-b "$ucd:/lib/ucd" -b "$ucd/keyboard:/lib/keyboard")
	# /bin is a symlink to /system/bin on Android; bind rc at the resolved
	# directory so that #!/bin/rc scripts find it.
	bindir=$( [ -d /bin ] && readlink -f /bin || echo /bin )
	[ ! -x "$PLAN9/bin/rc" ] || wrap+=(-b "$PLAN9/bin/rc:$bindir/rc")
	for d in "$tree"/*; do
		n=$(basename "$d")
		case $n in sys|lib|rc|usr|adm|tmp|mnt|n|dev|env|proc|fd|srv|net|bin|wasm32) continue ;; esac
		[ -d "$d/include" ] || [ -d "$d/bin" ] || [ -d "$d/lib" ] || continue	# an /$objtype
		wrap+=(-b "$d:/$n")
	done
	;;
unshare)
	wrap=(unshare $( [ "$(id -u)" = 0 ] || echo -r ) -m --propagation private)
	;;
*)
	echo "native: NATIVE_WRAP=$wrap_mode? (direct, bwrap, proot or unshare)" >&2
	exit 2
	;;
esac
"${wrap[@]}" bash -s "$tree" "$bin" "$PLAN9" "$ucd" "$hosttouch" $dirs <<'X'
set -e
tree=$1 bin=$2 P9=$3 ucd=$4 hosttouch=$5; shift 5
if [ ! -d /sys/src ]; then	# unshare: the mounts here
	/usr/bin/mount --bind "$tree/sys" /sys
	/usr/bin/mount --bind "$tree/wasm32" /wasm32
	/usr/bin/mount --bind "$ucd" /lib/ucd
	/usr/bin/mount --bind "$ucd/keyboard" /lib/keyboard
fi
k=/sys/src/cmd/aux/kbdfs
if [ -e $k/latin1.h ]; then
	: >$k/mklatin.amd64; "$hosttouch" -d '+1 min' $k/latin1.h
fi
# awk's proctab.c (made by maketab, a program for the host) and awkgram.c, y.tab.h (yacc's): made
# above; a stand-in maketab newer than its inputs, the made files newer than both
a=/sys/src/cmd/awk
if [ -e $a/proctab.c ]; then
	"$hosttouch" -d '-3 min' $a/awkgram.y $a/maketab.c
	"$hosttouch" -d '-2 min' $a/y.tab.h $a/awkgram.c
	: >$a/amd64.maketab; "$hosttouch" -d '-1 min' $a/amd64.maketab
	"$hosttouch" $a/proctab.c
fi
export CPP=$bin/cpp PATH=$bin:$P9/bin:$PATH PLAN9=$P9 objtype=wasm32 cputype=amd64 FORCERCFORMK=1	# FORCERCFORMK: plan9port's mk runs recipes in rc, as 9front's mkfiles are written
for d in "$@"; do
	t=install
	case $d in *:*) t=${d#*:} t=${t//,/ } d=${d%%:*} ;; esac
	echo "native: /sys/src/$d: mk $t"
	mkdir -p /wasm32/bin/aux /wasm32/bin/auth /wasm32/bin/games /wasm32/bin/ip /wasm32/bin/disk /wasm32/bin/ndb /wasm32/bin/fs
	# /$objtype/bin's directories as 9front has them for amd64 (venti, upas, replica ...), and acme's
	[ ! -d /amd64/bin ] || (cd /amd64/bin && find . -mindepth 1 -type d) | while read -r b; do mkdir -p "/wasm32/bin/$b"; done
	[ ! -d /acme/bin ] || mkdir -p /acme/bin/wasm32
	cd "/sys/src/$d" || { echo "native: no /sys/src/$d" >&2; exit 1; }
	mk ${MKFLAGS:-} $t
done
X
echo "native: ok"
