#!/bin/rc
# Plan2001 AMD64 9frontin omalla työkaluketjulla (mk, 6c, 6a, 6l,
# aux/aout2efi) bootstrap-koneessa (tools/native-amd64/build): lukitun
# lähteen (upstream/9front.lock, tools/tree) koko /sys/src - kirjastot,
# ohjelmat, acme - sekä ydin, UEFI-loader ja man-indeksit.
#
# Levyt (AHCI, katso vm9.py):
#	sdE1	bootstrap-ISO (lukon BOOT_ISO): vain vaiheen 1 kääntäjät ja
#		työkalut, ei mitään toimitettavaa
#	sdE2	sisään: tämä skripti ja koottu puu (root) tar-muodossa,
#		purettu hakemistoon /tmp/p2 ennen tätä
#	sdE3	ulos: root.tar (käännetty juuri: puu, /amd64/bin, /amd64/lib,
#		/acme/bin/amd64, asennetut rc-skriptit, man-indeksit),
#		9pc64, bootx64.efi (ja bootaa64.efi), rc, kbdfs, libc.a,
#		entry.txt tar-muodossa
#
# Vaihe 1 kääntää koko lähteen bootstrap-työkaluilla uuteen /amd64:ään.
# Vaihe 2 on 9frontin oma release (sys/src/mkfile): nuke, kirjastot pois,
# mk install vaiheen 1 työkaluilla ja kääntäjillä.  Toimitettava on siis
# lukitun lähteen kääntäjien kääntämää lukittua lähdettä.
#
# Käyttö: rc build.rc [aa64]
rfork ne
p2=/tmp/p2
root=$p2/root

fn die {
	echo 'build.rc: '^$"* >[1=2]
	exit $"*
}

fn vaihe {
	echo '---' $"* `{date}
}

9660srv >[2]/dev/null
mount /srv/9660 /n/boot /dev/sdE1/data || die 'bootstrap-ISO ei liity'
test -x /n/boot/amd64/bin/6c || die 'bootstrap-ISO:lla ei ole 6c:tä'
test -f $root/sys/src/mkfile || die 'koottu puu puuttuu'

# uusi /amd64: include ja mkfile lähteestä, bin ja lib käännöksestä;
# /amd64/bin:n ja /rc/bin:n alihakemistot kuten 9frontissa (git ei
# säilytä tyhjiä hakemistoja, mk install ei tee niitä)
mkdir -p $root/amd64/bin $root/amd64/lib $root/acme/bin/amd64
for(t in amd64/bin rc/bin)
	for(d in `{walk -d /n/boot/$t | sed 's|^/n/boot/'^$t^'/?||'})
		if(! ~ $d '')
			mkdir -p $root/$t/$d
for(d in $root/amd64 $root/amd64/bin $root/amd64/lib $root/acme/bin/amd64)
	chmod 775 $d

objtype=amd64
cputype=amd64
bind -c $root/amd64 /amd64
bind -c $root/acme /acme
bind -c $root/sys /sys
bind -bc $root/lib /lib
# vaihe 1: bootstrap-julkaisun työkalut, ei käännöskoneen omia
bind -b /n/boot/amd64/bin /bin
bind -b /n/boot/rc/bin /bin

vaihe 'vaihe 1: /sys/src bootstrap-työkaluilla'
cd /sys/src
mk install >[2=1] || die 'vaihe 1'
test -x /amd64/bin/6c -a -x /amd64/bin/rc -a -x /amd64/bin/mk || die 'vaihe 1: työkaluketju puuttuu'

# vaihe 2: vain uudet työkalut ja lähteen rc-skriptit, järjestyksessä kuin
# 9frontin nimiavaruudessa (/$cputype/bin, sen perään /rc/bin)
bind -c $root/rc /rc
bind /amd64/bin /bin
bind -a /rc/bin /bin
vaihe 'vaihe 2: release vaiheen 1 työkaluilla'
cd /sys/src
mk nuke >[2=1] || die 'vaihe 2: nuke'
rm -f /amd64/lib/*.a
mk install >[2=1] || die 'vaihe 2'
mk clean >[2=1] || die 'vaihe 2: clean'
nm /amd64/lib/libc.a | grep -s -e ' [Tt] spawn$' && die 'native spawn interface leaked'

vaihe 'ydin: /sys/src/9/pc64'
cd /sys/src/9/pc64 || die pc64
# Bootfs inherits directory permissions from the target tree.
mkdir -p pc64.bootfs
chmod 775 pc64.bootfs
mk 'CONF=pc64' >[2=1] || die 'ytimen käännös'
mkdir -p /n/p2boot
paqfs -q -m /n/p2boot pc64.bootfs.paq || die bootfs
cmp /n/p2boot/amd64/bin/aux/kbdfs /amd64/bin/aux/kbdfs || die 'bootfs:n kbdfs ei ole käännetty'
cmp /n/p2boot/amd64/bin/rc /amd64/bin/rc || die 'bootfs:n rc ei ole käännetty'

vaihe 'UEFI-loader: /sys/src/boot/efi'
cd /sys/src/boot/efi || die efi
mk bootx64.efi >[2=1] || die 'bootx64.efi:n käännös'
aa64=()
if(~ $1 aa64){
	if(mk bootaa64.efi >[2=1])
		aa64=bootaa64.efi
	if not
		echo 'build.rc: bootaa64.efi ei käänny (ARM64 ei kuulu AMD64-vaiheeseen)'
}

vaihe 'man-indeksit: /sys/man'
cd /sys/man
mk indices >[2=1] || die 'man-indeksit'

vaihe 'tulokset'
out=$p2/out
rm -rf $out
mkdir -p $out
cp /sys/src/9/pc64/9pc64 /sys/src/boot/efi/bootx64.efi $out || die kopio
if(! ~ $#aa64 0)
	cp /sys/src/boot/efi/bootaa64.efi $out
cp /amd64/bin/rc $out/rc || die 'rc kopio'
cp /amd64/bin/aux/kbdfs $out/kbdfs || die 'kbdfs kopio'
cp /amd64/lib/libc.a $out/libc.a || die libc-output
nm /sys/src/9/pc64/9pc64 | grep -e ' _efi64$' -e ' T main$' >$out/entry.txt
# käännetty juuri ilman ytimen ja loaderin välitiedostoja
@{cd /sys/src/9/pc64 && mk clean && rm -rf pc64.bootfs} >[2=1] || die 'ytimen siivous'
@{cd /sys/src/boot/efi && mk clean} >[2=1] || die 'loaderin siivous'
@{cd $root && tar c *} >$out/root.tar || die root.tar
cd $out
ls -l
tar c * >/dev/sdE3/data || die 'tulosten kirjoitus'
echo 'build.rc: valmis'
