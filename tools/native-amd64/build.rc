#!/bin/rc
# Plan2001 AMD64 -käännös 9front-11952-koneessa (tools/native-amd64/build).
# 9frontin oma työkaluketju: mk, 6c, 6a, 6l, aux/aout2efi.
#
# Levyt (AHCI, katso vm9.py):
#	sdE1	pinnattu 9front-11952.amd64.iso: lähteet, otsakkeet, kirjastot
#		ja työkalut, ei koneen omaa (mahdollisesti muutettua) /sys/src:tä
#	sdE2	sisään: tämä skripti ja koottu lähde (src, include) tar-muodossa,
#		purettu hakemistoon /tmp/p2 ennen tätä
#	sdE3	ulos: 9pc64, bootx64.efi (ja bootaa64.efi) tar-muodossa
#
# Käyttö: rc build.rc [aa64]
rfork ne
p2=/tmp/p2

fn die {
	echo 'build.rc: '^$"* >[1=2]
	exit $"*
}

9660srv >[2]/dev/null
mount /srv/9660 /n/dist /dev/sdE1/data || die 'ISO ei liity'
test -d /n/dist/sys/src/9/pc64 || die 'ISO:lla ei ole /sys/src/9/pc64'

# kääntäjät, kirjastot ja otsakkeet julkaisusta; BootInfo-otsake overlaysta
bind -b /n/dist/amd64/bin /bin
bind /n/dist/rc /rc
bind /n/dist/lib /lib
# Writable target libraries, with compiler programs from the pinned ISO.
mkdir -p $p2/amd64/include $p2/amd64/lib $p2/amd64/bin
# Bootfs inherits directory permissions from the target tree.
chmod 775 $p2/amd64 $p2/amd64/bin $p2/amd64/lib $p2/amd64/include
cp /n/dist/amd64/mkfile $p2/amd64/mkfile
dircp /n/dist/amd64/include $p2/amd64/include || die headers
dircp /n/dist/amd64/lib $p2/amd64/lib || die libraries
rm -rf $p2/amd64/include/ape $p2/amd64/lib/ape
bind $p2/amd64 /amd64
bind /n/dist/amd64/bin /amd64/bin
bind $p2/include /sys/include
bind $p2/src /sys/src
objtype=amd64
cd /sys/src/libc
mk install >[2=1] || die libc

# Ytimen bootfs ottaa ohjelmat nimiavaruuden /amd64/bin:stä: korjattu
# kbdfs (sarjakonsolin syöte, patches/9front/kbdfs-*.diff)
# julkaisun binäärin päälle ennen ytimen käännöstä.
echo '--- aux/kbdfs'
cd /sys/src/cmd/aux/kbdfs || die kbdfs
mk >[2=1] || die 'kbdfs käännös'
bind 6.out /amd64/bin/aux/kbdfs || die 'kbdfs bind'

echo '--- ydin: /sys/src/9/pc64'
cd /sys/src/9/pc64 || die pc64
# The build VM may have private parent permissions; the boot user must
# be able to traverse the paq root, regardless of workspace permissions.
mkdir -p pc64.bootfs
chmod 775 pc64.bootfs
mk 'CONF=pc64' >[2=1] || die 'ytimen käännös'
mkdir -p /n/p2boot
paqfs -q -m /n/p2boot pc64.bootfs.paq || die bootfs
ls -ld /n/p2boot /n/p2boot/amd64 /n/p2boot/amd64/bin /n/p2boot/rc /n/p2boot/rc/bin
ls -l /n/p2boot/rc/bin/bootrc /n/p2boot/amd64/bin/rc
cmp /n/p2boot/amd64/bin/aux/kbdfs /sys/src/cmd/aux/kbdfs/6.out || die 'bootfs:n kbdfs ei ole korjattu'


echo '--- UEFI-loader: /sys/src/boot/efi'
cd /sys/src/boot/efi || die efi
mk bootx64.efi >[2=1] || die 'bootx64.efi:n käännös'
aa64=()
if(~ $1 aa64){
	if(mk bootaa64.efi >[2=1])
		aa64=bootaa64.efi
	if not
		echo 'build.rc: bootaa64.efi ei käänny (ARM64 ei kuulu AMD64-vaiheeseen)'
}

echo '--- yhdistetty rc: /sys/src/cmd/rc'
cd /sys/src/cmd/rc || die rc
mk >[2=1] || die 'rc käännös'

rm -rf $p2/out
mkdir -p $p2/out
cp /sys/src/9/pc64/9pc64 /sys/src/boot/efi/bootx64.efi $p2/out || die kopio
cp /sys/src/cmd/rc/6.out $p2/out/rc || die 'rc kopio'
cp /sys/src/cmd/aux/kbdfs/6.out $p2/out/kbdfs || die 'kbdfs kopio'
if(! ~ $#aa64 0)
	cp /sys/src/boot/efi/bootaa64.efi $p2/out
nm /amd64/lib/libc.a | grep -e ' [Tt] spawn$' && die 'native spawn interface leaked'
cp /amd64/lib/libc.a $p2/out/libc.a || die libc-output
cd $p2/out
nm /sys/src/9/pc64/9pc64 | grep -e ' _efi64$' -e ' T main$' >entry.txt
ls -l
tar c * >/dev/sdE3/data || die 'tulosten kirjoitus'
echo 'build.rc: valmis'
