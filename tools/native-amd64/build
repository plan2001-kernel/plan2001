#!/usr/bin/env python3
"""
Plan2001 AMD64: 9front-11952:n pc64-ydin (9pc64), rc ja UEFI-loader
(bootx64.efi) 9frontin omalla työkaluketjulla (mk, 6c, 6a, 6l,
aux/aout2efi) 9front-11952-koneessa QEMU:ssa.  Linux-isäntä vain
valmistelee levyt ja lukee tulokset; isännän GCC:tä ei käytetä.

    tools/native-amd64/build [--shared HAK] [--out HAK] [--aa64]

Lähteet: pinnattu 9front-11952-ISO (SHA256 tarkistetaan) + tämän puun
AMD64- ja yhteinen koottu 9front-lähde (pc64/shared, port, ip, boot/efi) + yhteinen
BootInfo v1 (sys/include/bootinfo.h, sys/src/9/port/boot{info,args,fb}.c)
hakemistosta --shared (oletus: tämä puu).  Käännöskone: PLAN2001_BUILDVM
(oletus ~/.cache/plan2001/base.qcow2), ajetaan kertakäyttöisen
qcow2-kerroksen päällä ilman verkkoa.  Tulokset: --out (oletus
~/.cache/plan2001/native-amd64): 9pc64, bootx64.efi, rc, kbdfs, build.log.
"""

import argparse
import os
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import vm9  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--shared", default=vm9.JUURI, help="yhteisen BootInfo v1:n lähdepuu")
    ap.add_argument("--out", default=vm9.oletus_ulos())
    ap.add_argument("--iso")
    ap.add_argument("--buildvm")
    ap.add_argument("--aa64", action="store_true", help="käännä myös bootaa64.efi (tarkistus)")
    a = ap.parse_args()

    iso = vm9.etsi_iso(a.iso)
    pohja = vm9.etsi_buildvm(a.buildvm)
    os.makedirs(a.out, exist_ok=True)
    loki = os.path.join(a.out, "build.log")
    if os.path.exists(loki):
        os.unlink(loki)

    with tempfile.TemporaryDirectory(prefix="p2build-") as tyo:
        kone = vm9.overlay_kone(pohja, tyo, "buildvm.qcow2")
        sisaan = vm9.tar_levylle(os.path.join(tyo, "in.img"),
                                  [("build.rc", os.path.join(vm9.TAMA, "build.rc"))]
                                  + vm9.source_jasenet(tyo, os.path.abspath(a.shared)))
        ulos = vm9.tyhja_levy(os.path.join(tyo, "out.img"))
        vm = vm9.Kone([(kone, "qcow2", False, "hd"),
                       (iso, "raw", True, "cd"),
                       (sisaan, "raw", False, "hd"),
                       (ulos, "raw", False, "hd")],
                      vm9.Ovmf.etsi(), loki, muisti="2048", cpu="2")
        vm.kaynnista()
        try:
            vm9.kaynnista_9front(vm, 300)
            vm.aja("rm -rf /tmp/p2 && mkdir -p /tmp/p2 && cd /tmp/p2 && tar xf /dev/sdE2/data", 120)
            vm.aja("rc /tmp/p2/build.rc" + (" aa64" if a.aa64 else ""), 3600)
        finally:
            vm.sammuta()
        tiedostot = vm9.tar_levylta(ulos, a.out)

    for t in ("9pc64", "bootx64.efi", "rc", "kbdfs"):
        if t not in tiedostot:
            raise vm9.VirheVM("%s puuttuu tuloksista (%s)" % (t, loki))
    magic, entry = vm9.aout_entry(os.path.join(a.out, "9pc64"))
    nm = open(os.path.join(a.out, "entry.txt")).read()
    efi64 = [int(r.split()[0], 16) for r in nm.splitlines() if r.endswith(" _efi64")]
    if not efi64 or efi64[0] != entry:
        raise vm9.VirheVM("9pc64:n a.out-sisääntulo %#x ei ole _efi64 (%s)" % (entry, nm.strip()))
    # loader lataa tekstin sisääntulo-osoitteeseen: _efi64 on tekstin alku (KTZERO)
    if entry != 0xffffffff80110000:
        raise vm9.VirheVM("9pc64:n sisääntulo %#x ei ole KTZERO (pc64/mkfile, l.s)" % entry)
    teksti = open(os.path.join(a.out, "9pc64"), "rb").read()[40:40 + 8192]
    mb = teksti.find(bytes.fromhex("02b0ad1b"))
    if mb < 0 or mb % 4 != 0:
        raise vm9.VirheVM("multiboot-otsake ei ole 4 tavun tasauksessa (%d)" % mb)
    print("9pc64: a.out magic %#x, entry _efi64 %#x, multiboot-otsake +%d" % (magic, entry, mb))
    for t in sorted(tiedostot):
        print("%-14s %9d  %s" % (t, os.path.getsize(os.path.join(a.out, t)), os.path.join(a.out, t)))


if __name__ == "__main__":
    try:
        main()
    except vm9.VirheVM as e:
        print("build: %s" % e, file=sys.stderr)
        sys.exit(1)
