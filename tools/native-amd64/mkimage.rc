#!/bin/rc
# Plan2001 AMD64 -levykuva 9front-11952-koneessa (tools/native-amd64/mkimage).
# Samat vaiheet kuin 9frontin asentajassa (inst/prepdisk, mountcwfs,
# copydist, bootsetup "use esp as 9fat"), ilman kysymyksiä:
#
#	ESP (GPT, isännän tekemä)	FAT: \EFI\BOOT\BOOTX64.EFI, 9pc64, plan9.ini
#	Plan 9 -osio (GPT)		nvram fscache fsworm other, cwfs64x
#					ja 9front-11952:n jakelu (allproto)
#
# Levyt: sdE1 pinnattu ISO (jakelu), sdE2 sisään (tämä skripti, 9pc64,
# bootx64.efi, rc, kbdfs, termrc, console, plan9.ini ja karsittu lähde; purettu
# hakemistoon /tmp/p2), sdE3 kohdelevy.
#
# Käyttö: rc mkimage.rc LEVY
#	LEVY	kohdelevyn nimi kohdekoneessa, esim. sdE0 (plan9.ini:n
#		bootargs ja cwfs:n asetuslohko viittaavat siihen)
rfork ne
p2=/tmp/p2
t=/dev/sdE3
disk=$1
user=glenda
sname=cwfs.newfs

fn die {
	echo 'mkimage.rc: '^$"* >[1=2]
	exit $"*
}

~ $#disk 1 || die 'käyttö: mkimage.rc LEVY'

9660srv >[2]/dev/null
mount /srv/9660 /n/dist /dev/sdE1/data || die 'ISO ei liity'
test -d /n/dist/dist/9front || die 'ISO:lla ei ole jakelua'

# Käytä varmennetun julkaisun työkaluja ja kopiointiprotoa, ei
# käännöskoneeseen mahdollisesti muutettuja versioita.
bind -b /n/dist/amd64/bin /bin
bind -b /n/dist/rc/bin /bin

# GPT-osiot ctl-tiedostoon (diskparts: disk/edisk -p)
diskparts $t
test -f $t/esp || die 'kohdelevyllä ei ole ESP:tä'
test -f $t/plan9 || die 'kohdelevyllä ei ole Plan 9 -osiota'

echo '--- Plan 9 -osion jako (inst/prepdisk, ESP 9fatina)'
disk/prep -bw -a^(nvram fscache fsworm other) $t/plan9 || die 'disk/prep'
disk/prep -p $t/plan9 >$t/ctl >[2]/dev/null
for(p in nvram fscache fsworm other)
	test -f $t/$p || die 'osio puuttuu: '^$p

echo '--- ESP'
disk/format -d -l PLAN2001 $t/esp || die 'ESP:n alustus'
rm -f /srv/dos.p2
dossrv -f $t/esp dos.p2 || die dossrv
mount -c /srv/dos.p2 /n/esp || die 'ESP ei liity'
mkdir -p /n/esp/efi/boot
cp $p2/bootx64.efi /n/esp/efi/boot/bootx64.efi || die 'loaderin kopio'
cp $p2/9pc64 /n/esp/9pc64 || die 'ytimen kopio'
cp $p2/plan9.ini /n/esp/plan9.ini || die 'plan9.ini:n kopio'
ls -l /n/esp /n/esp/efi/boot
# dossrv synkronoi jokaisen clunkin yhteydessä (dosfs.c rclunk)
unmount /n/esp
rm -f /srv/dos.p2

echo '--- cwfs64x (inst/mountcwfs)'
# cwfs tallettaa laitepolut asetuslohkoon: kohdelevy näkyy tässä
# nimiavaruudessa nimellä, joka sillä on kohdekoneessa (oma juuri ei muutu)
mkdir -p $p2/dev/$disk
bind $t $p2/dev/$disk || die 'bind '^$disk
bind -b $p2/dev /dev
test -f /dev/$disk/fscache || die 'kohdelevy ei näy nimellä '^$disk
fs=/dev/$disk/fscache
fsworm=/dev/$disk/fsworm
fsother=/dev/$disk/other
{
	echo service cwfs
	echo config $fs
	echo noauth
	echo filsys main c'('$fs')('$fsworm')'
	echo filsys dump o
	echo filsys other '('$fsother')'
	echo ream other
	echo ream main
	echo end
} >/tmp/fsconfig.p2
rm -f /srv/$sname /srv/$sname.cmd
cwfs64x -n $sname -f $fs -C -c </tmp/fsconfig.p2 || die 'cwfs ream'
{
	echo noattach
	echo allow
	echo users default
	echo cfs main
	echo create /adm adm adm 775 d
	echo create /adm/users adm adm 664
	echo create /dist sys sys 775 d
	echo create /usr sys sys 775 d
	echo newuser $user
	echo newuser adm +$user
	echo newuser sys +$user
	echo newuser upas +$user
	echo cfs other
	echo create /usr sys sys 775 d
	echo create /usr/$user $user $user 775 d
	echo create /usr/$user/tmp $user $user 750 d
	echo cfs main
	echo noattach
	sleep 2
} >>/srv/$sname.cmd
n=0
while(! mount -c /srv/$sname /n/newfs){
	n=`{echo $n + 1 | hoc}
	if(~ $n 30)
		die 'cwfs ei liity'
	sleep 2
}

echo '--- jakelu (inst/copydist)'
disk/mkfs -z 16372 -U -s /n/dist -d /n/newfs /n/dist/sys/lib/sysconfig/proto/allproto >/tmp/mkfs.p2 >[2=1]
tail -5 /tmp/mkfs.p2
if(grep -s 'can''t (create|write)|file system full' /tmp/mkfs.p2)
	die 'jakelun kopio epäonnistui (cwfs:n välimuisti liian pieni? suurenna --size)'
test -x /n/newfs/amd64/bin/rc || die 'jakelun kopio epäonnistui'

# Asennettu lähdepuu on sama karsittu puu, josta ydin käännettiin.
rm -rf /n/newfs/sys/src /n/newfs/sys/include /n/newfs/sys/lib /n/newfs/sys/doc /n/newfs/sys/man /n/newfs/rc
mkdir -p /n/newfs/sys/src /n/newfs/sys/include /n/newfs/sys/lib /n/newfs/sys/doc /n/newfs/sys/man /n/newfs/rc
dircp $p2/src /n/newfs/sys/src || die 'lähdepuun kopio'
dircp $p2/include /n/newfs/sys/include || die 'otsakkeiden kopio'
dircp $p2/syslib /n/newfs/sys/lib || die 'sys/lib-kopio'
dircp $p2/sysdoc /n/newfs/sys/doc || die 'sys/doc-kopio'
dircp $p2/sysman /n/newfs/sys/man || die 'sys/man-kopio'
dircp $p2/rcroot /n/newfs/rc || die 'rc-kopio'
rm -rf /n/newfs/amd64/include/ape /n/newfs/amd64/lib/ape /n/newfs/amd64/bin/ape
rm -rf /n/newfs/amd64/bin/bitsy
rm -f /n/newfs/amd64/bin/gs /n/newfs/amd64/bin/pcc
for(p in 1a 1c 1l 2a 2c 2l 5a 5c 5e 5i 5l 8a 8c 8l 9a 9c 9l ka kc ki kl qa qc qi ql va vc vl tc tl)
	rm -f /n/newfs/amd64/bin/$p
for(p in compress eqn grap pic spin vi)
	rm -f /n/newfs/amd64/bin/$p
for(p in 8prefix apm antiword lpdaemon lpdsend lpsend cropmarks download g3p9bit grabit hardcopy p9bitpost postgif postprint postreverse posttek tcpostio text2post tr2post)
	rm -f /n/newfs/amd64/bin/aux/$p
for(p in flacdec flacenc mp3enc oggdec oggenc)
	rm -f /n/newfs/amd64/bin/audio/$p
rm -rf /n/newfs/386 /n/newfs/68000 /n/newfs/68020 /n/newfs/arm /n/newfs/mips /n/newfs/power /n/newfs/power64 /n/newfs/sparc /n/newfs/sparc64 /n/newfs/spim
rm -rf /n/newfs/acme/bin/386 /n/newfs/acme/bin/arm /n/newfs/acme/bin/mips /n/newfs/acme/bin/power /n/newfs/acme/bin/power64 /n/newfs/acme/bin/sparc /n/newfs/acme/bin/sparc64 /n/newfs/acme/bin/spim
test -f /n/newfs/sys/include/bootinfo.h || die 'BootInfo-otsake puuttuu'
cp $p2/rc /n/newfs/amd64/bin/rc || die 'yhdistetyn rc:n kopio'
# sama korjattu kbdfs kuin ytimen bootfs:ssä; sarjakonsolin oma kuori
cp $p2/kbdfs /n/newfs/amd64/bin/aux/kbdfs || die 'kbdfs:n kopio'
cp $p2/termrc $p2/console /n/newfs/rc/bin/ || die 'termrc:n ja consolen kopio'

# Plan2001:n ydin ja loader myös asennettuun järjestelmään, jotta
# 9frontin omat työkalut (inst/bootsetup, 9fs 9fat) käyttävät niitä
cp $p2/9pc64 /n/newfs/amd64/9pc64 || die 'ytimen kopio juureen'
cp $p2/bootx64.efi /n/newfs/amd64/bootx64.efi || die 'loaderin kopio juureen'

echo '--- cwfs: sync ja halt'
unmount /n/newfs
echo sync >>/srv/$sname.cmd
sleep 5
echo halt >>/srv/$sname.cmd
n=0
while(test -e /srv/$sname && ! ~ $n 60){
	n=`{echo $n + 1 | hoc}
	sleep 1
}
test -e /srv/$sname && die 'cwfs ei pysähtynyt'
echo 'mkimage.rc: valmis'
