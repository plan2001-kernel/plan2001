#!/bin/bash
# The tree Plan2001 is built in: 9front's source at upstream/9front.lock's
# COMMIT (tools/upstream source), its patch stack (patches/9front/series,
# each patch applied only to the exact file it was made from), this tree's
# own files over it - new files only: one that would replace an upstream
# file stops the assembly - and tools/prune-tree's selection of the
# supported targets (tools/upstream assemble).  9front's root layout: /sys,
# /rc, /$objtype ... as a 9front machine's /.  Only git's files of this
# tree; the tree made anew.
#   tools/tree [DIR]	default build/tree
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
out=${1:-$root/build/tree}
src=$("$here/upstream" source)
rm -rf "$out"; mkdir -p "$out"
cp -a "$src/." "$out/"
rm -f "$out/.plan2001-upstream"
"$here/upstream" assemble "$out"
# what 9front ships made from another file (libsec's X.c and libauthsrv's
# X.mpc from X.mp, by mpc) newer than it, as on a 9front machine: mk would
# make it again with a tool the host lacks
find "$out" -name '*.mp' | while read -r m; do
	for g in "${m%.mp}.c" "${m}c"; do [ ! -e "$g" ] || touch "$g"; done
done
echo "tree: $out"
