#!/usr/bin/env python3
"""Apply Plan2001's supported-target source selection to an assembled 9front root."""

import pathlib
import re
import shutil
import sys


def remove(path):
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        path.unlink(missing_ok=True)


def replace(path, old, new):
    data = path.read_text()
    if old not in data:
        raise SystemExit(f"prune-tree: expected {old!r} in {path}")
    path.write_text(data.replace(old, new))


def config_sources(directory, configs, extra=()):
    names = set(extra)
    for config in configs:
        section = ""
        for line in (directory / config).read_text().splitlines():
            if not line or line.startswith("#"):
                continue
            if line[0] not in " \t":
                section = line.split()[0]
                continue
            if section not in {"dev", "link", "misc", "ip"}:
                continue
            words = line.split()
            if not words:
                continue
            if section == "dev":
                names.add("dev" + words[0])
            else:
                names.add(words[0])
            names.update(w for w in words[1:] if not w.startswith(("+", "-", "=")))
    return names


def move_shared(src, dst, names):
    dst.mkdir(exist_ok=True)
    for file in src.iterdir():
        if file.suffix == ".c" and file.stem in names:
            shutil.move(str(file), dst / file.name)
        elif file.suffix in {".h", ".i", ".fw", ".n"}:
            shutil.move(str(file), dst / file.name)
    remove(src)


def prune_libmach(directory):
    keep = {"executable", "map", "obj", "swap", "sym", "access", "machdata",
            "setmach", "6", "7", "7db", "8db", "6obj", "7obj"}
    for file in directory.iterdir():
        if file.suffix == ".c" and file.stem not in keep:
            remove(file)
    remove(directory / "mips2ureg.h")
    mk = directory / "mkfile"
    data = mk.read_text()
    start = data.index("OFILES=\\\n")
    end = data.index("\n\nHFILES=", start)
    data = data[:start] + "OFILES=\\\n" + "".join(f"\t{name}.$O\\\n" for name in sorted(keep)) + data[end:]
    data = re.sub(r"(?m)^(?:2obj|5obj|8obj|kobj|qobj|vobj)\.\$O:.*\n", "", data)
    mk.write_text(data)

    obj = directory / "obj.c"
    data = obj.read_text()
    start = data.index("int\t_is2(char*)")
    end = data.index("\n\ntypedef struct Obj", start)
    data = data[:start] + "int\t_is6(char*), _is7(char*),\n\t_read6(Biobuf*, Prog*), _read7(Biobuf*, Prog*);" + data[end:]
    start = data.index("static Obj\tobj[] =")
    end = data.index("\n\nstruct\tSymtab", start)
    data = data[:start] + "static Obj\tobj[] =\n{\n\t[ObjAmd64]\t\"amd64 .6\", _is6, _read6,\n\t[ObjArm64]\t\"arm64 .7\", _is7, _read7,\n\t[Maxobjtype]\t0, 0\n};" + data[end:]
    obj.write_text(data)

    setmach = directory / "setmach.c"
    data = setmach.read_text()
    start = data.index("extern\tMach\t")
    end = data.index("\n/*\n *\tmachine selection table", start)
    data = data[:start] + "extern Mach mamd64, marm64;\nextern Machdata i386mach, arm64mach;\n" + data[end:]
    start = data.index("Machtab\tmachines[] =")
    end = data.index("\n\n/*\n *\tselect a machine", start)
    entries = re.findall(r"\t\{[^}]*\},", data[start:end], re.S)
    selected = [e for e in entries if '"amd64"' in e or '"arm64"' in e]
    if len(selected) != 2:
        raise SystemExit("prune-tree: libmach machine table changed")
    data = data[:start] + "Machtab\tmachines[] =\n{\n" + "\n".join(selected) + "\n\t{ 0 },\n};" + data[end:]
    data = data.replace("asstype = AMIPS;\n\t\tmachdata = &mipsmach;\n\t\tmach = &mmips;",
                        "asstype = AAMD64;\n\t\tmachdata = &i386mach;\n\t\tmach = &mamd64;")
    setmach.write_text(data)

    machdata = directory / "machdata.c"
    data = machdata.read_text().replace("extern\tMachdata\tmipsmach;\n", "")
    data = data.replace("int\tasstype = AMIPS;", "int\tasstype = AAMD64;")
    machdata.write_text(data)

    exe = directory / "executable.c"
    data = exe.read_text()
    start = data.index("extern\tMach\tmmips;")
    end = data.index("\nExecTable exectab[] =", start)
    data = data[:start] + "extern Mach mamd64, marm64;\n" + data[end:]
    start = data.index("ExecTable exectab[] =")
    end = data.index("\n\nMach\t*mach", start)
    entries = re.findall(r"\t\{[^}]*\},", data[start:end], re.S)
    selected = [e.replace("&mi386", "&mamd64") for e in entries
                if "&mamd64" in e or "&marm64" in e or "ELF_MAG" in e]
    if len(selected) != 3:
        raise SystemExit("prune-tree: libmach executable table changed")
    data = data[:start] + "ExecTable exectab[] =\n{\n" + "\n".join(selected) + "\n\t{ 0 },\n};" + data[end:]
    data = data.replace("Mach\t*mach = &mi386;", "Mach\t*mach = &mamd64;")
    data = data.replace("\tcase E_MAGIC:\n\t\tthumbpctab(fd, fp);\n\t\tbreak;\n", "")
    data = data.replace("\t/* arm needs to check for both arm and thumb */\n\tif(fp->type == FARM && (fp->entry & mthumb.ktmask))\n\t\tgoto FTHUM;\n", "")
    start = data.index("\tswitch(fp->type) {", data.index("commonboot(Fhdr *fp)"))
    end = data.index("\n\tfp->hdrsz = 0;", start)
    data = data[:start] + '''\tswitch(fp->type) {
\tcase FARM64:
\t\tfp->type = FARM64B;
\t\tfp->txtaddr = fp->entry;
\t\tfp->name = "arm64 plan 9 boot image";
\t\tfp->dataddr = _round(fp->txtaddr+fp->txtsz, mach->pgsize);
\t\tbreak;
\tcase FAMD64:
\t\tfp->type = FAMD64B;
\t\tfp->txtaddr = fp->entry;
\t\tfp->name = "amd64 plan 9 boot image";
\t\tfp->dataddr = _round(fp->txtaddr+fp->txtsz, 4096);
\t\tbreak;
\tdefault:
\t\treturn;
\t}''' + data[end:]
    arch_switch = "switch(ep->machine) {"
    start = data.index(arch_switch)
    end = data.index("\n\tif(ep->phentsize", start)
    data = data[:start] + '''switch(ep->machine) {
\tcase AMD64:
\t\tmach = &mamd64;
\t\tfp->type = FAMD64;
\t\tfp->name = "amd64 ELF64 executable";
\t\tbreak;
\tdefault:
\t\treturn 0;
\t}
''' + data[end:]
    start = data.index(arch_switch, start + len(arch_switch))
    end = data.index("\n\tif(ep->phentsize", start)
    data = data[:start] + '''switch(ep->machine) {
\tcase AMD64:
\t\tmach = &mamd64;
\t\tfp->type = FAMD64;
\t\tfp->name = "amd64 ELF32 executable";
\t\tbreak;
\tdefault:
\t\treturn 0;
\t}
''' + data[end:]
    exe.write_text(data)


# PostScript programs built with pcc (APE) from sys/src/cmd/postscript.
# tr2post, text2post, p9bitpost, g3p9bit and the rc/PostScript tools
# (cropmarks, grabit, hardcopy, printfont, psencoding) are native and stay.
POSTSCRIPT_APE = ("download", "postgif", "postprint", "postreverse", "posttek", "tcpostio")


def prune_postscript(root):
    ps = root / "sys/src/cmd/postscript"
    # common/ stays for the native programs' headers and tr2post's
    # common.c; only its pcc library com.a goes with the APE programs.
    for name in ("mkfile", "bbox.c", "getopt.c", "glob.c", "misc.c",
                 "request.c", "request.h", "tempnam.c", "gen.h"):
        remove(ps / "common" / name)
    # unbuilt UNIX remnants that link the same pcc library
    for name in POSTSCRIPT_APE + ("picpack", "postbgi", "postdaisy", "postdmd", "postmd", "postio"):
        remove(ps / name)
    mk = ps / "mkfile"
    data = mk.read_text()
    data = data.replace("TARGETS=common\\\n\t", "TARGETS=", 1)
    for name in POSTSCRIPT_APE:
        old = f"\t{name}\\\n"
        if data.count(old) != 1:
            raise SystemExit(f"prune-tree: {name} not a target in {mk}")
        data = data.replace(old, "")
    for name in ("picpack", "postbgi", "postdaisy", "postdmd", "postmd", "postio"):
        data = re.sub(rf"(?m)^#\t{name}\\?\n", "", data)
    mk.write_text(data)
    # dpost -f adds fonts with aux/download, which needs APE.
    replace(root / "rc/bin/dpost", "\taux/tr2post $* | addpsfonts\n",
            "\techo 'dpost: -f needs aux/download, which is unavailable' >[1=2]\n\texit unsupported\n")


def prune_syscall_stubs(path):
    """Keep only the supported targets' system call stubs (wasm32 has its own)."""
    data = path.read_text()
    start = data.index("\t\t{switch($objtype){\n") + len("\t\t{switch($objtype){\n")
    end = data.index("\t\t}} > $i.s\n", start)
    blocks = re.split(r"(?m)^(?=\t\tcase )", data[start:end])
    if blocks[0]:
        raise SystemExit(f"prune-tree: unexpected system call switch in {path}")
    kept = [b for b in blocks[1:] if b.split("\n", 1)[0].split()[1:] in (["amd64"], ["arm64"])]
    if len(kept) != 2:
        raise SystemExit(f"prune-tree: amd64/arm64 system call stubs changed in {path}")
    path.write_text(data[:start] + "".join(kept) + data[end:])


def prune_page(path):
    data = path.read_text()
    start = data.index("typedef struct Ghost Ghost;")
    end = data.index("int\ninfernobithdr(", start)
    data = data[:start] + data[end:]
    start = data.index("int\npopengs(")
    end = data.index("int\nfiletype(", start)
    data = data[:start] + data[end:]
    data = "\n".join(line for line in data.split("\n") if "popengs," not in line)
    data = data.replace("int ppi = 100;\n", "")
    data = data.replace(" [ -p ppi ]", "")
    data = data.replace("\tcase 'p':\n\t\tppi = atoi(EARGF(usage()));\n\t\tbreak;\n", "")
    path.write_text(data)


def prune_distproto(path):
    unsupported = {"386", "68000", "68020", "arm", "power", "power64",
                   "sparc", "sparc64", "mips", "spim"}
    kept = []
    section = ""
    for line in path.read_text().splitlines(keepends=True):
        if line and line[0] not in " \t#\n":
            section = line.split()[0]
        if section in unsupported:
            continue
        name = line.strip().split()[0] if line.strip() else ""
        if name in {"ape", "bitsy"} or (section == "acme" and name in unsupported):
            continue
        kept.append(line)
    path.write_text("".join(kept))


def prune_dist_mkfile(path):
    data = path.read_text()
    header = data[:data.index("cd:V:")]
    gzip = data[data.index("%.gz:D:"):data.index("%.386.iso:")]
    pi3 = data[data.index("%.pi3.img:"):data.index("%.zynq.img:D:")]
    disk = data[data.index("%.disk:D:"):data.index("binds:V:")]
    old = "if(~ $target *.pi.img.* *.pi3.img.*){"
    if disk.count(old) != 1:
        raise SystemExit(f"prune-tree: Pi3 image rule changed in {path}")
    disk = disk.replace(old, "if(~ $target *.pi3.img.*){")
    start = disk.index("\tif not if(~ $target *.reform.img.*")
    end = disk.index("\thjfs -f $d/fs", start)
    disk = disk[:start] + disk[end:]
    path.write_text(header + gzip + pi3 + disk + data[data.index("binds:V:"):])


def prune_authproto(path, old_compilers):
    obsolete = set(old_compilers) | {"pcc", "gs", "compress", "eqn", "grap", "pic",
                                     "spin", "vi", "lp", "lpdaemon", "lpdsend",
                                     "lpsend", "antiword", "8prefix", "apm", "dpost",
                                     *POSTSCRIPT_APE, "flacdec", "flacenc", "mp3enc",
                                     "oggdec", "oggenc"}
    old_arch = {"386", "68000", "68020", "arm", "mips", "power", "power64",
                "sparc", "sparc64", "spim"}
    kept = []
    section = ""
    skip_indent = None
    for line in path.read_text().splitlines(keepends=True):
        indent = len(line) - len(line.lstrip(" \t"))
        name = line.strip().split()[0] if line.strip() else ""
        if line and line[0] not in " \t#\n":
            section = name
        if section in old_arch:
            continue
        if skip_indent is not None:
            if indent > skip_indent:
                continue
            skip_indent = None
        if name == "bitsy" or (section == "sys" and name == "lp"):
            skip_indent = indent
            continue
        if section == "rc" and name in {"fax", "lp"}:
            continue
        if section == "$cputype" and name in obsolete:
            continue
        kept.append(line)
    path.write_text("".join(kept))


