#!/usr/bin/env python3
"""Apply Plan2001's supported-target source selection to an assembled 9front root."""

import pathlib
import re
import shutil
import sys


def remove(path):
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        path.unlink(missing_ok=True)


def replace(path, old, new):
    data = path.read_text()
    if old not in data:
        raise SystemExit(f"prune-tree: expected {old!r} in {path}")
    path.write_text(data.replace(old, new))


def config_sources(directory, configs, extra=()):
    names = set(extra)
    for config in configs:
        section = ""
        for line in (directory / config).read_text().splitlines():
            if not line or line.startswith("#"):
                continue
            if line[0] not in " \t":
                section = line.split()[0]
                continue
            if section not in {"dev", "link", "misc", "ip"}:
                continue
            words = line.split()
            if not words:
                continue
            if section == "dev":
                names.add("dev" + words[0])
            else:
                names.add(words[0])
            names.update(w for w in words[1:] if not w.startswith(("+", "-", "=")))
    return names


def move_shared(src, dst, names):
    dst.mkdir(exist_ok=True)
    for file in src.iterdir():
        if file.suffix == ".c" and file.stem in names:
            shutil.move(str(file), dst / file.name)
        elif file.suffix in {".h", ".i", ".fw", ".n"}:
            shutil.move(str(file), dst / file.name)
    remove(src)


def prune_libmach(directory):
    keep = {"executable", "map", "obj", "swap", "sym", "access", "machdata",
            "setmach", "6", "7", "7db", "8db", "6obj", "7obj"}
    for file in directory.iterdir():
        if file.suffix == ".c" and file.stem not in keep:
            remove(file)
    remove(directory / "mips2ureg.h")
    mk = directory / "mkfile"
    data = mk.read_text()
    start = data.index("OFILES=\\\n")
    end = data.index("\n\nHFILES=", start)
    data = data[:start] + "OFILES=\\\n" + "".join(f"\t{name}.$O\\\n" for name in sorted(keep)) + data[end:]
    data = re.sub(r"(?m)^(?:2obj|5obj|8obj|kobj|qobj|vobj)\.\$O:.*\n", "", data)
    mk.write_text(data)

    obj = directory / "obj.c"
    data = obj.read_text()
    start = data.index("int\t_is2(char*)")
    end = data.index("\n\ntypedef struct Obj", start)
    data = data[:start] + "int\t_is6(char*), _is7(char*),\n\t_read6(Biobuf*, Prog*), _read7(Biobuf*, Prog*);" + data[end:]
    start = data.index("static Obj\tobj[] =")
    end = data.index("\n\nstruct\tSymtab", start)
    data = data[:start] + "static Obj\tobj[] =\n{\n\t[ObjAmd64]\t\"amd64 .6\", _is6, _read6,\n\t[ObjArm64]\t\"arm64 .7\", _is7, _read7,\n\t[Maxobjtype]\t0, 0\n};" + data[end:]
    obj.write_text(data)

    setmach = directory / "setmach.c"
    data = setmach.read_text()
    start = data.index("extern\tMach\t")
    end = data.index("\n/*\n *\tmachine selection table", start)
    data = data[:start] + "extern Mach mamd64, marm64;\nextern Machdata i386mach, arm64mach;\n" + data[end:]
    start = data.index("Machtab\tmachines[] =")
    end = data.index("\n\n/*\n *\tselect a machine", start)
    entries = re.findall(r"\t\{[^}]*\},", data[start:end], re.S)
    selected = [e for e in entries if '"amd64"' in e or '"arm64"' in e]
    if len(selected) != 2:
        raise SystemExit("prune-tree: libmach machine table changed")
    data = data[:start] + "Machtab\tmachines[] =\n{\n" + "\n".join(selected) + "\n\t{ 0 },\n};" + data[end:]
    data = data.replace("asstype = AMIPS;\n\t\tmachdata = &mipsmach;\n\t\tmach = &mmips;",
                        "asstype = AAMD64;\n\t\tmachdata = &i386mach;\n\t\tmach = &mamd64;")
    setmach.write_text(data)

    machdata = directory / "machdata.c"
    data = machdata.read_text().replace("extern\tMachdata\tmipsmach;\n", "")
    data = data.replace("int\tasstype = AMIPS;", "int\tasstype = AAMD64;")
    machdata.write_text(data)

    exe = directory / "executable.c"
    data = exe.read_text()
    start = data.index("extern\tMach\tmmips;")
    end = data.index("\nExecTable exectab[] =", start)
    data = data[:start] + "extern Mach mamd64, marm64;\n" + data[end:]
    start = data.index("ExecTable exectab[] =")
    end = data.index("\n\nMach\t*mach", start)
    entries = re.findall(r"\t\{[^}]*\},", data[start:end], re.S)
    selected = [e.replace("&mi386", "&mamd64") for e in entries
                if "&mamd64" in e or "&marm64" in e or "ELF_MAG" in e]
    if len(selected) != 3:
        raise SystemExit("prune-tree: libmach executable table changed")
    data = data[:start] + "ExecTable exectab[] =\n{\n" + "\n".join(selected) + "\n\t{ 0 },\n};" + data[end:]
    data = data.replace("Mach\t*mach = &mi386;", "Mach\t*mach = &mamd64;")
    data = data.replace("\tcase E_MAGIC:\n\t\tthumbpctab(fd, fp);\n\t\tbreak;\n", "")
    data = data.replace("\t/* arm needs to check for both arm and thumb */\n\tif(fp->type == FARM && (fp->entry & mthumb.ktmask))\n\t\tgoto FTHUM;\n", "")
    start = data.index("\tswitch(fp->type) {", data.index("commonboot(Fhdr *fp)"))
    end = data.index("\n\tfp->hdrsz = 0;", start)
    data = data[:start] + '''\tswitch(fp->type) {
\tcase FARM64:
\t\tfp->type = FARM64B;
\t\tfp->txtaddr = fp->entry;
\t\tfp->name = "arm64 plan 9 boot image";
\t\tfp->dataddr = _round(fp->txtaddr+fp->txtsz, mach->pgsize);
\t\tbreak;
\tcase FAMD64:
\t\tfp->type = FAMD64B;
\t\tfp->txtaddr = fp->entry;
\t\tfp->name = "amd64 plan 9 boot image";
\t\tfp->dataddr = _round(fp->txtaddr+fp->txtsz, 4096);
\t\tbreak;
\tdefault:
\t\treturn;
\t}''' + data[end:]
    arch_switch = "switch(ep->machine) {"
    start = data.index(arch_switch)
    end = data.index("\n\tif(ep->phentsize", start)
    data = data[:start] + '''switch(ep->machine) {
\tcase AMD64:
\t\tmach = &mamd64;
\t\tfp->type = FAMD64;
\t\tfp->name = "amd64 ELF64 executable";
\t\tbreak;
\tdefault:
\t\treturn 0;
\t}
''' + data[end:]
    start = data.index(arch_switch, start + len(arch_switch))
    end = data.index("\n\tif(ep->phentsize", start)
    data = data[:start] + '''switch(ep->machine) {
\tcase AMD64:
\t\tmach = &mamd64;
\t\tfp->type = FAMD64;
\t\tfp->name = "amd64 ELF32 executable";
\t\tbreak;
\tdefault:
\t\treturn 0;
\t}
''' + data[end:]
    exe.write_text(data)


def prune_page(path):
    data = path.read_text()
    start = data.index("typedef struct Ghost Ghost;")
    end = data.index("int\ninfernobithdr(", start)
    data = data[:start] + data[end:]
    start = data.index("int\npopengs(")
    end = data.index("int\nfiletype(", start)
    data = data[:start] + data[end:]
    data = "\n".join(line for line in data.split("\n") if "popengs," not in line)
    data = data.replace("int ppi = 100;\n", "")
    data = data.replace(" [ -p ppi ]", "")
    data = data.replace("\tcase 'p':\n\t\tppi = atoi(EARGF(usage()));\n\t\tbreak;\n", "")
    path.write_text(data)


def prune_lp(path):
    data = path.read_text()
    data, nested = re.subn(r"(?ms)^\t\tcase \*gs[^\n]*\n.*?(?=^\t\tcase |^\t\t\})", "", data)
    if nested != 2:
        raise SystemExit(f"prune-tree: expected 2 nested Ghostscript printer cases in {path}, got {nested}")
    data, count = re.subn(r"(?ms)^\tcase \*gs[^\n]*\n.*?(?=^\tcase |^\t\})", "", data)
    if count != 23:
        raise SystemExit(f"prune-tree: expected 23 Ghostscript printer cases in {path}, got {count}")
    replace_line = "\tcase *post*\n\t\t$proc/pdfpost $temp\n"
    if data.count(replace_line) != 1:
        raise SystemExit(f"prune-tree: expected PDF to PostScript printer case in {path}")
    path.write_text(data.replace(replace_line, ""))


def main(root):
    src = root / "sys/src"
    for name in ("386", "68000", "68020", "arm", "mips", "power", "power64", "sparc", "sparc64", "spim"):
        remove(root / name)
    for path in ("sys/src/ape", "sys/include/ape", "sys/lib/ghostscript",
                 "sys/src/cmd/gs", "sys/src/cmd/pcc.c", "sys/man/1/gs",
                 "sys/man/1/pc", "sys/man/1/pcc", "sys/man/1/2a",
                 "sys/man/1/2c", "sys/man/1/2l", "rc/bin/ape", "rc/lib/ape",
                 "sys/lib/dist/usr/glenda/bin/386", "rc/bin/pdf2ps",
                 "rc/bin/ps2pdf", "rc/bin/ps2gif", "rc/bin/psfax",
                 "rc/bin/troff2gif", "rc/bin/troff2png", "rc/bin/fax",
                 "sys/lib/lp/process/pdfgs", "sys/lib/lp/process/pdfgsijs",
                 "sys/lib/lp/process/gspipe", "sys/lib/lp/process/gspipeijs",
                 "sys/lib/lp/process/pdfpost", "sys/man/1/ps2pdf",
                 "sys/man/1/troff2png"):
        remove(root / path)
    for obj in ("386", "68020", "arm", "mips", "power", "sparc"):
        remove(root / "sys/lib/acid" / obj)
    for obj in ("amd64", "arm64", "wasm32"):
        for part in ("include/ape", "lib/ape", "bin/ape", "bin/gs"):
            remove(root / obj / part)
    for obj in ("386", "arm", "mips", "power", "power64", "sparc", "sparc64", "spim"):
        remove(root / "acme/bin" / obj)
    for path in ("sys/src/boot/efi/ia32.s", "wasm32/include/ape"):
        remove(root / path)
    remove(root / "rc/bin/inst/bootplan9")
    remove(root / "sys/lib/sysconfig/proto/pcproto")
    proto = root / "sys/lib/sysconfig/proto/portproto"
    if proto.exists():
        proto.write_text("\n".join(line for line in proto.read_text().splitlines()
                                   if line.strip() not in {"ape", "ghostscript", "apeselect"}) + "\n")

    pc64 = src / "9/pc64"
    pc = src / "9/pc"
    pcm = pc64 / "mkfile"
    pc_names = config_sources(pc64, ("pc64",),
                              ("cga", "i8253", "i8259", "irq", "memory", "screen", "init9"))
    move_shared(pc, pc64 / "shared", pc_names)
    replace(pc64 / "shared/sd53c8xx.c", '"../pc/sd53c8xx.i"', '"shared/sd53c8xx.i"')
    replace(pcm, "../pc/", "shared/")
    replace(pcm, "../pc}", "shared}")
    replace(pcm, "cd ../pc", "cd shared")
    replace(pcm, "/386/include/ureg.h", "/amd64/include/ureg.h")

    bcm64 = src / "9/bcm64"
    bcm = src / "9/bcm"
    bcmm = bcm64 / "mkfile"
    bcm_names = config_sources(bcm64, ("pi3", "pi4", "pi4efi"), ("bootargs",))
    move_shared(bcm, bcm64 / "shared", bcm_names)
    replace(bcmm, "../bcm/", "shared/")
    replace(bcmm, "../bcm |", "shared |")
    replace(bcm64 / "io.h", "../bcm/io.h", "shared/io.h")

    for board in (src / "9").iterdir():
        if board.is_dir() and board.name not in {"arm64", "bcm64", "boot", "ip", "pc64", "port", "wasm32"}:
            remove(board)
    for boot in (src / "boot").iterdir():
        if boot.is_dir() and boot.name not in {"bcm", "efi"}:
            remove(boot)

    # The numbered 3/6/7 compilers and cc's common backend stay available.
    old_compilers = ("1a", "1c", "1l", "2a", "2c", "2l", "5a", "5c", "5e", "5i", "5l",
                     "8a", "8c", "8l", "9a", "9c", "9l", "ka", "kc", "ki", "kl",
                     "qa", "qc", "qi", "ql", "va", "vc", "vl", "tc", "tl")
    for name in old_compilers:
        remove(src / "cmd" / name)
    for arch in ("386", "68000", "68020", "arm", "mips", "power", "power64", "sparc", "spim"):
        remove(src / "libc" / arch)
    for lib in ("libmp", "libsec"):
        for arch in ("386", "arm", "mips", "power", "power64", "spim"):
            remove(src / lib / arch)
    for arch in ("386", "arm", "mips", "power", "power64"):
        remove(src / "libthread" / (arch + ".c"))
    prune_libmach(src / "libmach")
    prune_page(src / "cmd/page.c")
    cmdmk = src / "cmd/mkfile"
    cmdmk.write_text(cmdmk.read_text() + "\n$O.page: page.$O /$objtype/lib/libgeometry.a\n\t$LD -o $target $prereq\n")
    prune_lp(root / "sys/lib/lp/process/generic")
    authproto = root / "sys/lib/sysconfig/auth/authproto"
    authproto.write_text(authproto.read_text().replace("\t\tgs\t\t775 sys sys\n", ""))
    remove(src / "cmd/bitsy")
    remove(src / "cmd/aux/multi")
    remove(src / "games/gba/rom")
    replace(src / "cmd/abaco/mkfile", "8c -a $CFLAGS", "$CC -a $CFLAGS")
    replace(src / "cmd/abaco/mkfile", "8c -aa", "$CC -aa")

    proto = src / "mkfile.proto"
    replace(proto, "OS=056789qvt", "OS=367")
    replace(proto, "CPUS=spim arm arm64 amd64 386 power power64 mips", "CPUS=amd64 arm64 wasm32")
    replace(src / "cmd/cc/mkfile", "CURCC=6c 8c qc vc\nOTHERCC=1c 2c 5c 7c kc", "CURCC=6c 7c 3c\nOTHERCC=")
    replace(src / "libc/mkfile", "OLDCPUS=68000 68020 sparc", "OLDCPUS=")
    replace(src / "libmp/mkfile", "for(objtype in 386)@{", "for(objtype in $CPUS)@{")
    replace(src / "libmp/mkfile", "objtype=arm; mk; mk 5.test 5.bigtest\n\tobjtype=amd64; mk; mk 6.test 6.bigtest\n\tobjtype=386; mk; mk 8.test 8.bigtest", "objtype=amd64; mk; mk 6.test 6.bigtest\n\tobjtype=arm64; mk; mk 7.test 7.bigtest\n\tobjtype=wasm32; mk; mk 3.test 3.bigtest")
    replace(src / "libmp/mkfile", "rm -f [568].* *.[568]", "rm -f [367].* *.[367]")

    mk = src / "mkfile"
    replace(mk, "SUBSYS=ape\\\n\t/acme\\\n", "SUBSYS=/acme\\\n")
    replace(mk, "\trm -f /$objtype/lib/ape/*.a\n", "")
    mk = src / "9/mkfile"
    data = mk.read_text()
    start = data.index("ARCH=\\\n")
    end = data.index("\n\nall:V:", start)
    mk.write_text(data[:start] + "ARCH=\\\n\tarm64\\\n\tbcm64\\\n\tpc64\\\n\twasm32\\\n" + data[end:])
    mk = src / "boot/mkfile"
    data = mk.read_text()
    start = data.index("ARCH=\\\n")
    end = data.index("\n\n", start)
    mk.write_text(data[:start] + "ARCH=bcm efi" + data[end:])


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: tools/prune-tree ASSEMBLED_ROOT")
    main(pathlib.Path(sys.argv[1]).resolve())
