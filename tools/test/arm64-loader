    # the device trees pftf's EDK2 forwards on a real Pi 4 (tools/rpi4/uefi-esp's pinned zip, if cached)
    fwzip = pathlib.Path(os.environ.get('PLAN2001_CACHE', os.path.expanduser('~/.cache/plan2001'))) / 'rpi4-uefi/RPi4_UEFI_Firmware_v1.53.zip'
    if fwzip.exists():
        import hashlib, zipfile
        if hashlib.sha256(fwzip.read_bytes()).hexdigest() != 'ca9973e2a7a546b3df871cfb7382e656829114b6dfa424f40dc67cc90a217d88':
            raise SystemExit('arm64-loader: %s does not match its pinned SHA256' % fwzip)
        with zipfile.ZipFile(fwzip) as z:
            for name in z.namelist():
                if name.startswith('bcm2711-') and name.endswith('.dtb'):
                    out = pathlib.Path(td) / ('pftf-' + name)
                    out.write_bytes(z.read(name))
                    args.append('dtb=%s' % out)
                    print('pftf v1.53: %s' % name)
    else:
        print('NOT RUN: pftf v1.53 device trees (%s not cached)' % fwzip)
    virt = pathlib.Path(td) / 'virt.dtb'
    if subprocess.run(['qemu-system-aarch64', '-machine', 'virt,dumpdtb=%s' % virt, '-nographic'],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0 and virt.exists():
        args.append('wrong=%s' % virt)
    else:
        print('NOT RUN: wrong-board FDT (qemu-system-aarch64 dumpdtb unavailable)')
    kernel = a.kernel or os.path.join(os.environ.get('PLAN2001_RPI4_OUT', os.path.expanduser('~/.cache/plan2001/rpi4')), '9pi4efi')
    if os.path.exists(kernel):
        args.append('kernel=%s' % kernel)
        print('kernel: %s' % kernel)
    else:
        print('NOT RUN: built 9pi4efi preflight (%s missing; tools/rpi4/build or --kernel)' % kernel)
    subprocess.run([str(exe)] + args, check=True)
