def make_fdt(reserved=False, dynamic=False):
    names = ['compatible', 'method', 'reg', 'dma-ranges', 'ranges', 'size', 'alloc-ranges',
             '#address-cells', '#size-cells']
    strings, offsets = b'', {}
    for name in names:
        offsets[name] = len(strings)
        strings += name.encode() + b'\0'
    st = bytearray()
    def word(n): st.extend(struct.pack('>I', n))
    def begin(name):
        word(1); raw=name.encode()+b'\0'; st.extend(raw); st.extend(b'\0' * (-len(raw) % 4))
    def end(): word(2)
    def prop(name, value):
        word(3); word(len(value)); word(offsets[name]); st.extend(value); st.extend(b'\0' * (-len(value) % 4))
    begin(''); prop('compatible', b'brcm,bcm2711\0')
    begin('psci'); prop('method', b'smc\0'); end()
    begin('cpus'); begin('cpu@0'); prop('reg', bytes(8)); end(); end()
    begin('emmc2bus'); prop('dma-ranges', bytes(20)); end()
    begin('scb'); begin('pcie@7d500000'); prop('ranges', bytes(28)); prop('dma-ranges', bytes(28)); end(); end()
    if reserved or dynamic:
        begin('reserved-memory'); prop('#address-cells', struct.pack('>I', 2));
        prop('#size-cells', struct.pack('>I', 2)); prop('ranges', b'')
        if reserved:
            begin('bootguard@2000000'); prop('reg', struct.pack('>QQ', 0x2000000, 0x10000)); end()
        if dynamic:
            begin('linux,cma'); prop('compatible', b'shared-dma-pool\0')
            prop('size', struct.pack('>Q', 0x400000))
            prop('alloc-ranges', struct.pack('>QQ', 0x10000000, 0x10000000)); end()
        end()
    end(); word(9)
    reserve=bytes(16); offstruct=40+len(reserve); offstrings=offstruct+len(st)
    header=struct.pack('>10I',0xd00dfeed,offstrings+len(strings),offstruct,offstrings,40,17,16,0,len(strings),len(st))
    return header+reserve+st+strings

