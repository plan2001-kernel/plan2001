                                                              json.dumps({"seq": s}).encode(), "application/json"), ok2)
            else:
                # katkeava pyyntö: otsakkeet, runko tai vastaus kesken (RST)
                tapa = random.choice(("otsakkeet", "runko", "vastaus", "vastaus"))
                if tapa == "runko":
                    f = lambda: k.api("POST", "/api/rooms/%s/images" % h, png(400000), "image/png",  # noqa: E731
                                      katkaisu=tapa)
                else:
                    f = lambda: k.api("GET", "/api/rooms/%s/messages?limit=50" % h, katkaisu=tapa)  # noqa: E731
                self.mittaa("room: katkaisu " + tapa, f)
        finally:
            k.lukko.release()

