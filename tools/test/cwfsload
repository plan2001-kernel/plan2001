        else:
            k = random.choice(komennot)
            self.mittaa("rcpu: komento", lambda: self.aja(k, 120), lambda t: t.koodi == 0)
        self.seis.wait(random.uniform(1, 6))

    def dump_kierros(self):
        if self.seis.wait(self.a.dump * 60):
            return
        self.mittaa("cwfs: dump", lambda: self.aja("echo dump >>/srv/cwfs.cmd", 60), lambda t: t.koodi == 0)
        self.tilasto.tapahtuma("cwfs: dump pyydetty")

    def terveys(self):
        """Jumin tunnistus: rcpu ja HTTP 80 eivät vastaa kahdesti peräkkäin."""
        perakkain = 0
        while not self.seis.wait(30):
            alku = time.time()
            r1 = self.mittaa("terveys: rcpu", lambda: self.aja("cat /dev/sysstat >/dev/null; ls /adm >/dev/null; "
                                                                "echo ok", 90),
                             lambda t: t.koodi == 0 and "ok" in t.stdout)
            r2 = self.mittaa("terveys: http80", lambda: pyynto(self.http, "GET", "/sivut/s2.html", tls=False,
                                                                aikaraja=90),
                             lambda r: r[0] == 200)
            if r1 is None and r2 is None:
                perakkain += 1
                self.tilasto.tapahtuma("terveys: ei vastausta (%d/2, %.0f s)" % (perakkain, time.time() - alku))
                if perakkain >= 2:
                    self.jumi = "rcpu ja HTTP 80 eivät vastaa"
                    self.sarja.kaatumisrivi = self.sarja.kaatumisrivi or "JUMI: " + self.jumi
                    self.sarja.kaatui.set()
                    return
            else:
                perakkain = 0

    def tilanne(self):
        while not self.seis.wait(600):
            with self.klukko:
                n = len(self.kayttajat)
            self.tilasto.tapahtuma("tilanne: %d käyttäjää, %d huonetta, havainnot %s"
                                   % (n, len(self.huoneet), self.sarja.havainnot or "-"))
            open(os.path.join(self.a.lokit, "yhteenveto.txt"), "w").write(self.tilasto.raportti() + "\n")

    def kuorma(self):
        a = self.a
        # alkukäyttäjät
        while len(self.kayttajat) < a.kayttajat:
            self.mittaa("tili: uusi", lambda: self.uusi_kayttaja(BOOTSTRAP_HUONE))
        self.tilasto.tapahtuma("alkukäyttäjät: %d" % len(self.kayttajat))
        # vieraan oma tiedostojärjestelmäkuorma omassa note-ryhmässään
        # sarjakonsolilta: rcpu-istunto ei pääty, kun taustaprosessin nimiavaruus viittaa sen /mnt/termiin
        self.aja_ok("rm -rf /tmp/kuorma; mkdir -p /tmp/kuorma")
        self.v.vm.laheta("for(x in a b c) @{ rfork s; rc /cfg/load/kuorma.rc $x </dev/null >/dev/null "
                         ">[2]/tmp/kuorma/$x.err & }\n")
        for i in range(a.room_saikeet):
            self.saie("room%d" % i, self.room_kierros)
        for i in range(a.staattiset):
            self.saie("staattinen%d" % i, self.staattinen_kierros)
        for i in range(a.skannerit):
            self.saie("skanneri%d" % i, self.skanneri_kierros)
        self.saie("tilit", self.tili_kierros)
        self.saie("natiivi", self.natiivi_kierros)
        if a.dump > 0:
            self.saie("dump", self.dump_kierros)
        for f in (self.terveys, self.tilanne):
            t = threading.Thread(target=f, daemon=True)
            t.start()
            self.saikeet.append(t)
        self.tilasto.tapahtuma("kuorma käynnissä: %d Room-, %d staattista, %d skanneri-, tili-, rcpu- ja dump-säie; "
                               "kesto %d min" % (a.room_saikeet, a.staattiset, a.skannerit, a.kesto))
        loppu = time.time() + a.kesto * 60
        while time.time() < loppu and not self.sarja.kaatui.is_set():
            self.sarja.kaatui.wait(min(10, max(0.1, loppu - time.time())))
        kaatui = self.sarja.kaatui.is_set()
        self.seis.set()
        for t in self.saikeet:
            t.join(60)
        return kaatui

    # --- kaatumisen tai jumin diagnoosi ---

    def diagnoosi(self):
        """Pelastusshell sarjakonsolilla (ei tarvitse cwfs:ää), sitten muistivedos QMP:llä."""
        self.sarja.pysayta()
        vm = self.v.vm
        polku = os.path.join(self.a.lokit, "diagnoosi.log")
        alku = len(vm.kaikki)
        vm.puskuri = b""
        vm.laheta("\x14\x14r")
        try:
            vm.odota(r"rescue# ", 30)
        except vm9.VirheVM as e:
            self.tilasto.tapahtuma("pelastusshell ei avautunut: %s" % str(e)[-200:])
        komennot = [
            "bind '#p' /proc; cd /proc",
            "for(p in `{ls}) { echo '##' $p `{cat $p/args >[2]/dev/null} `{cat $p/status >[2]/dev/null} }",
            # cwfs-prosessien pinot; Broken-tilainen on kaatunut (lukko jää varatuksi)
            "for(p in `{ls}) if(grep -s cwfs $p/status >[2]/dev/null) { echo '###' $p `{cat $p/status}; "
            "echo 'lstk()' | acid $p >[2=1] }",
            "cat /dev/kmesg",
            "cat '#S/sdctl'",
        ]
        for k in komennot:
            tunnus = secrets.token_hex(3)
            vm.laheta("%s; echo P2D^%s\n" % (k, tunnus))
            try:
                vm.odota(r"P2D" + tunnus, 300)
            except vm9.VirheVM:
                self.tilasto.tapahtuma("diagnoosi: komento ei päättynyt: %s" % k[:80])
        open(polku, "wb").write(vm.kaikki[alku:])
        self.tilasto.tapahtuma("diagnoosi: %s" % polku)
        if self.a.muistivedos:
            vedos = os.path.join(self.a.lokit, "muisti.elf")
            try:
                vm.qmp("dump-guest-memory", aikaraja=600, paging=False, protocol="file:" + vedos)
                self.tilasto.tapahtuma("muistivedos: %s" % vedos)
            except Exception as e:
                self.tilasto.tapahtuma("muistivedos epäonnistui: %s" % e)

    def lopetus(self, kaatui):
        if kaatui:
            self.diagnoosi()
            self.v.vm.lopeta()
            sail = os.path.join(self.a.lokit, "levy.img")
            shutil.move(self.levy, sail)
            self.tilasto.tapahtuma("levykuva säilytetty: %s" % sail)
            return
        # ei kaatumista: vieraan kuorma pois, cwfs alas hallitusti
        self.sarja.pysayta()
        try:
            self.aja("touch /tmp/kuorma/seis", 60)
            time.sleep(5)
            t = self.aja("cat /adm/users | wc -l; ls /usr | wc -l; cat /tmp/kuorma/*.err", 60)
            self.tilasto.tapahtuma("loppu: users-rivit, kotihakemistot, vieraan kuorman virheet: %s"
                                   % t.stdout.strip().replace("\n", " | ")[:500])
            # palvelujen lokit (tlssrv, roomhttp, asuser, accountd, listen) talteen
            t = self.aja("for(f in /sys/log/https /sys/log/www /sys/log/listen.load /sys/log/listen "
                         "/sys/log/auth /adm/room/account.log /adm/room/push.log) "
                         "if(test -e $f) { echo '####' $f; cat $f }", 120)
            open(os.path.join(self.a.lokit, "vieraan-lokit.txt"), "w").write(t.stdout)
        except vm9.VirheVM as e:
            self.tilasto.tapahtuma("loppu: rcpu ei vastannut: %s" % e)
        valmis = self.v.sammuta()
        self.tilasto.tapahtuma("fshalt %s" % ("valmis" if valmis else "EI valmistunut"))
        if self.a.keep:
            sail = os.path.join(self.a.lokit, "levy.img")
            shutil.move(self.levy, sail)
            self.tilasto.tapahtuma("levykuva säilytetty: %s" % sail)

    def siivoa(self):
        if self.v:
            self.v.siivoa()
        shutil.rmtree(self.tyo, ignore_errors=True)


def main():
    oletus_lokit = os.path.join(os.path.expanduser("~/.cache/plan2001/cwfsload"),
                                "ajo-" + time.strftime("%Y%m%d-%H%M%S"))
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--kuva", required=True, help="mkimage --disk sd00 --console 0 -kuva (ei muuteta)")
    ap.add_argument("--room", default=os.path.join(os.path.dirname(JUURI), "room"))
    ap.add_argument("--room-rev", default="4cc670a",
                    help="Roomin commit (vanha datataso roomhttp/roomapi/roomwrite)")
    ap.add_argument("--lokit", default=oletus_lokit)
    ap.add_argument("--tyohak", default=None, help="kertakäyttöisen levykopion hakemisto")
    ap.add_argument("--kesto", type=int, default=480, help="minuuttia (oletus 480)")
    ap.add_argument("--muisti", type=int, default=1024, help="MiB (OCI E2.1.Micro: 1024)")
    ap.add_argument("--cpu", type=int, default=2)
    ap.add_argument("--cpuquota", type=int, default=0, help="QEMU:n suoritinaika %% (0: ei rajaa)")
    ap.add_argument("--kayttajat", type=int, default=6, help="käyttäjiä alussa")
    ap.add_argument("--maxkayttajat", type=int, default=60)
    ap.add_argument("--tilivali", type=float, default=40, help="tilitoimintojen keskiväli sekunteina")
    ap.add_argument("--room-saikeet", type=int, default=6)
    ap.add_argument("--staattiset", type=int, default=3)
    ap.add_argument("--skannerit", type=int, default=3)
    ap.add_argument("--dump", type=int, default=30, help="cwfs:n dump minuutin välein (0: ei)")
    ap.add_argument("--ei-muistivedosta", dest="muistivedos", action="store_false")
    ap.add_argument("--keep", action="store_true", help="säilytä levykuva myös ilman kaatumista")
    a = ap.parse_args()
    a.kuva = os.path.abspath(a.kuva)
    os.makedirs(a.lokit, exist_ok=True)
    if a.tyohak is None:
        a.tyohak = a.lokit
    t = Testi(a)
    paluu = 2
    tulos = "keskeytetty"
    try:
        t.kaynnista()
        t.asetukset()
        t.tarkista_palvelut()
        kaatui = t.kuorma()
        t.lopetus(kaatui)
        paluu = 1 if kaatui else 0
        tulos = ("KAATUI/JUMI: " + t.sarja.kaatumisrivi) if kaatui else "ei kaatumista"
    except Exception as e:
        tulos = "TESTIN VIRHE: %s" % e
        traceback.print_exc()
    finally:
        try:
            raportti = "%s\n\n%s\n\nsarjakonsolin havainnot: %s\n" % (
                tulos, t.tilasto.raportti(), t.sarja.havainnot if t.sarja else "-")
        except Exception:
            raportti = "raportti epäonnistui\n"
        open(os.path.join(a.lokit, "yhteenveto.txt"), "w").write(raportti)
        print(raportti)
        t.siivoa()
    sys.exit(paluu)


if __name__ == "__main__":
    main()
