class Testi:
    def __init__(self, a):
        self.a = a
        os.makedirs(a.lokit, exist_ok=True)
        self.tilasto = Tilasto(a.lokit)
        self.tyo = tempfile.mkdtemp(prefix="cwfsload-", dir=a.tyohak)
        self.v = None
        self.sarja = None
        self.seis = threading.Event()
        self.kayttajat = []
        self.klukko = threading.Lock()
        self.huoneet = [BOOTSTRAP_HUONE]
        self.kutsut = {}
        self.saikeet = []
        self.nimilaskuri = 0
        self.jumi = None

    # --- vieras ---

    def aja(self, komento, aikaraja=120, stdin=b""):
        return self.v.pterm.aja(komento, aikaraja=aikaraja, stdin=stdin)

    def aja_ok(self, komento, aikaraja=120):
        t = self.aja(komento, aikaraja)
        if t.koodi != 0:
            raise vm9.VirheVM("%s: %s %s %s" % (komento[:120], t.status, t.stdout[-800:], t.stderr[-800:]))
        return t

    def put(self, paikallinen, eta):
        t = self.v.pterm.put(paikallinen, eta)
        if t.koodi != 0:
            raise vm9.VirheVM("put %s: %s %s" % (eta, t.status, t.stderr))

    def post_otsakkeet(self):
        return {"Origin": ORIGIN}

    def kaynnista(self):
        a = self.a
        self.levy = os.path.join(self.tyo, "levy.img")
        subprocess.check_call(["cp", "--sparse=always", a.kuva, self.levy])
        if a.cpuquota:
            kaare = os.path.join(self.tyo, "qemu-quota")
            with open(kaare, "w") as f:
                f.write("#!/bin/sh\nexec systemd-run --user --scope -q -p CPUQuota=%d%% %s \"$@\"\n"
                        % (a.cpuquota, os.environ.get("QEMU", "qemu-system-x86_64")))
            os.chmod(kaare, 0o755)
            os.environ["QEMU"] = kaare
        # OCI: juuri virtio-scsi target 0 LUN 1 (sd00); provisiointi target 1 LUN 0 (sd01)
        self.v = cpuvieras.CpuVieras(self.levy, self.tyo, os.path.join(a.lokit, "sarja.log"),
                                     laji="vscsi:s0:0:1", muisti=str(a.muisti), cpu=str(a.cpu),
                                     provisiointi=("vscsi:s0:1:0", "sd01"), lisaportit=(443, 80))
        self.https = self.v.portit[443]
        self.http = self.v.portit[80]
        self.v.kaynnista()
        t = self.v.provisioi()
        if t.stdout != "glenda":
            raise vm9.VirheVM("provisiointi: %r" % (t,))
        self.tilasto.tapahtuma("vieras käynnissä: %s MiB, %s suoritinta, juuri sd00 (vscsi t0 l1)"
                               % (a.muisti, a.cpu))

    def tls_avain(self):
        avain = rsa.generate_private_key(public_exponent=65537, key_size=2048)
        nimi = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, RP)])
        nyt = time.time()
        import datetime
