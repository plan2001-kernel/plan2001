    def saie(self, nimi, f, *args):
        def kaari():
            while not self.seis.is_set():
                try:
                    f(*args)
                except Exception as e:
                    self.tilasto.kirjaa(nimi + ": poikkeus", False, 0, "%s: %s" % (type(e).__name__, e))
                    self.seis.wait(1)
        t = threading.Thread(target=kaari, name=nimi, daemon=True)
        t.start()
        self.saikeet.append(t)

    def mittaa(self, toiminto, f, hyva=lambda r: True):
        alku = time.time()
        try:
            r = f()
            ok = hyva(r)
            self.tilasto.kirjaa(toiminto, ok, time.time() - alku, "" if ok else repr(r)[:300])
            return r if ok else None
        except Exception as e:
            self.tilasto.kirjaa(toiminto, False, time.time() - alku, "%s: %s" % (type(e).__name__, e))
            return None

