        if not k.lukko.acquire(blocking=False):
            return
        try:
            h = random.choice(k.huoneet)
            x = random.random()
            ok2 = lambda r: r is not None and r[0] == 200  # noqa: E731
            if x < 0.15:
                self.mittaa("room: me", lambda: k.api("GET", "/api/me"), ok2)
            elif x < 0.45:
                # PWA hakee viimeiset; joskus koko historia (jokainen viesti luetaan exportfs-unionista)
                q = "?limit=50" if random.random() < 0.85 else ""
                r = self.mittaa("room: viestit", lambda: k.api("GET", "/api/rooms/%s/messages%s" % (h, q)), ok2)
                if r and random.random() < 0.3:
                    try:
