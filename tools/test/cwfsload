class Tilasto:
    """Säieturvalliset laskurit toiminnoittain ja tapahtumaloki."""

    def __init__(self, lokihak):
        self.lukko = threading.Lock()
        self.ok = {}
        self.virhe = {}
        self.viive = {}
        self.viimeinen = {}
        self.alku = time.time()
        self.tapahtumat = open(os.path.join(lokihak, "tapahtumat.log"), "a", buffering=1)

    def kirjaa(self, toiminto, onnistui, kesto=0.0, tieto=""):
        with self.lukko:
            d = self.ok if onnistui else self.virhe
            d[toiminto] = d.get(toiminto, 0) + 1
            n, s, m = self.viive.get(toiminto, (0, 0.0, 0.0))
            self.viive[toiminto] = (n + 1, s + kesto, max(m, kesto))
            if not onnistui and tieto:
                self.viimeinen[toiminto] = tieto[:300]

    def tapahtuma(self, teksti):
        rivi = "%s %7.0f s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), time.time() - self.alku, teksti)
        with self.lukko:
            self.tapahtumat.write(rivi + "\n")
        print(rivi)
        sys.stdout.flush()

    def raportti(self):
        with self.lukko:
            rivit = ["%-24s %8s %8s %9s %9s" % ("toiminto", "ok", "virhe", "ka. s", "max s")]
            for t in sorted(set(self.ok) | set(self.virhe)):
                n, s, m = self.viive.get(t, (0, 0.0, 0.0))
                rivit.append("%-24s %8d %8d %9.2f %9.2f" % (t, self.ok.get(t, 0), self.virhe.get(t, 0),
                                                           s / n if n else 0, m))
            if self.viimeinen:
                rivit.append("")
                rivit.append("viimeisimmät virheet:")
                for t, v in sorted(self.viimeinen.items()):
                    rivit.append("  %s: %s" % (t, v.replace("\n", " | ")))
            return "\n".join(rivit)


class Sarja:
    """
    Sarjakonsoli tyhjennetään koko kuorman ajan (QEMU:n stdout-putki ei saa
    täyttyä) ja sen rivit verrataan kaatumis- ja havaintomalleihin.
    """

    def __init__(self, vm, tilasto):
        self.vm = vm
        self.tilasto = tilasto
        self.seis = threading.Event()
        self.kaatui = threading.Event()
        self.kaatumisrivi = ""
        self.havainnot = {}
        self.vajaa = b""
        self.saie = threading.Thread(target=self._aja, daemon=True)

    def kaynnista(self):
        self.saie.start()

    def pysayta(self):
        self.seis.set()
        self.saie.join(10)

    def _aja(self):
        while not self.seis.is_set():
            ennen = len(self.vm.kaikki)
            try:
                self.vm._lue(0.5)
            except vm9.VirheVM as e:
                self.kaatumisrivi = "QEMU: %s" % e
                self.kaatui.set()
                return
            uusi = self.vm.kaikki[ennen:]
            # muisti ei kasva rajatta: loki on levyllä
            if len(self.vm.kaikki) > (4 << 20):
                self.vm.kaikki = self.vm.kaikki[-(1 << 20):]
            self.vm.puskuri = self.vm.puskuri[-65536:]
            if uusi:
                self._rivit(uusi)

    def _rivit(self, data):
        data = self.vajaa + data
        rivit = data.split(b"\n")
        self.vajaa = rivit.pop()
        if len(self.vajaa) > 4096:
            rivit.append(self.vajaa)
            self.vajaa = b""
        for r in rivit:
            for m in KAATUMINEN:
                if m.search(r):
                    teksti = r.decode("latin-1").strip()
                    self.tilasto.tapahtuma("KAATUMINEN: " + teksti)
                    if not self.kaatui.is_set():
                        self.kaatumisrivi = teksti
                        self.kaatui.set()
                    break
            else:
                for m in HAVAINTO:
                    if m.search(r):
                        avain = m.pattern.decode("latin-1")
                        self.havainnot[avain] = self.havainnot.get(avain, 0) + 1
                        if self.havainnot[avain] <= 20:
                            self.tilasto.tapahtuma("havainto: " + r.decode("latin-1").strip())
                        break


