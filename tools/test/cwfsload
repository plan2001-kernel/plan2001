                r = self.mittaa("room: kuva %dk" % (koko // 1000), lambda: k.api(
                    "POST", "/api/rooms/%s/images" % h, png(koko), "image/png", aikaraja=300), ok2)
                self._muista(k, h, r)
            elif x < 0.83:
                omat = k.omat.get(h) or []
                if omat:
                    s = random.choice(omat)
                    self.mittaa("room: kuittaus", lambda: k.api("POST", "/api/rooms/%s/reactions" % h, json.dumps(
                        {"seq": s, "kind": random.choice(("ok", "no", "seen", ""))}).encode(), "application/json"), ok2)
            elif x < 0.88:
