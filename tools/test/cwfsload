    def skanneri_kierros(self):
        """Internetin skannerien kaltaiset yhteydet: tlssrv:n auth_proxy short read -tilanteet."""
        x = random.random()
        portti = self.https if random.random() < 0.8 else self.http

        def tcp():
            s = socket.create_connection(("127.0.0.1", portti), timeout=30)
            time.sleep(random.uniform(0, 2))
            rst(s) if random.random() < 0.5 else s.close()

        def puoli_hello():
            s = socket.create_connection(("127.0.0.1", self.https), timeout=30)
            # TLS 1.2 ClientHellon alku: tietue ja kättelyn otsake, sitten katkaisu
            s.sendall(bytes([0x16, 0x03, 0x01, 0x02, 0x00, 0x01, 0x00, 0x01, 0xfc, 0x03, 0x03]) + os.urandom(20))
            time.sleep(random.uniform(0, 1))
            rst(s)

        def kattely():
            s, raaka = yhdista(self.https, True, 30)
            time.sleep(random.uniform(0, 1))
            rst(raaka)

        def roska():
            s = socket.create_connection(("127.0.0.1", portti), timeout=30)
            s.sendall(os.urandom(random.randint(1, 600)))
            time.sleep(random.uniform(0, 1))
            rst(s)

        def hidas():
            s = socket.create_connection(("127.0.0.1", self.http), timeout=60)
            for c in b"GET /sivut/s1.html HTTP/1.1\r\nHost: localhost\r\n":
                s.sendall(bytes([c]))
                if self.seis.wait(0.3):
                    break
            rst(s)

        if x < 0.3:
            self.mittaa("skanneri: tcp", tcp)
        elif x < 0.55:
            self.mittaa("skanneri: puoli hello", puoli_hello)
        elif x < 0.8:
            self.mittaa("skanneri: kättely", kattely)
        elif x < 0.95:
            self.mittaa("skanneri: roska", roska)
        else:
            self.mittaa("skanneri: hidas", hidas)
        self.seis.wait(random.uniform(0.2, 2))

