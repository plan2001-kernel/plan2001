def tls_konteksti():
    k = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    k.check_hostname = False
    k.verify_mode = ssl.CERT_NONE
    return k


TLS = tls_konteksti()


def rst(s):
    """Yhteys poikki TCP RST:llä (SO_LINGER 0), kuten katkeava mobiiliyhteys."""
    try:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
    except OSError:
        pass
    try:
        s.close()
    except OSError:
        pass


def yhdista(portti, tls, aikaraja):
    raaka = socket.create_connection(("127.0.0.1", portti), timeout=aikaraja)
    if not tls:
        return raaka, raaka
    try:
        return TLS.wrap_socket(raaka, server_hostname=RP), raaka
    except Exception:
        rst(raaka)
        raise


def pyynto(portti, metodi, polku, tls=True, otsakkeet=None, runko=b"", aikaraja=120, katkaisu=None):
    """
    Yksi HTTP/1.1-pyyntö (Connection: close).  katkaisu: None, "otsakkeet"
    (puolet otsakkeista), "runko" (otsakkeet ja puolet rungosta) tai
    "vastaus" (luetaan vastauksen alku); niissä yhteys katkaistaan RST:llä.
    Palauttaa (status, otsakkeet, runko); katkaisussa status on 0.
    """
    s, raaka = yhdista(portti, tls, aikaraja)
    try:
        h = "%s %s HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n" % (metodi, polku)
        for k, v in (otsakkeet or {}).items():
            h += "%s: %s\r\n" % (k, v)
        if runko or metodi == "POST":
            h += "Content-Length: %d\r\n" % len(runko)
        h = (h + "\r\n").encode()
        if katkaisu == "otsakkeet":
            s.sendall(h[:max(1, len(h) // 2)])
            time.sleep(random.uniform(0, 0.5))
            rst(raaka)
            return 0, {}, b""
        s.sendall(h)
        if katkaisu == "runko":
            if runko:
                s.sendall(runko[:len(runko) // 2])
            time.sleep(random.uniform(0, 0.5))
            rst(raaka)
            return 0, {}, b""
        if runko:
            s.sendall(runko)
        if katkaisu == "vastaus":
            try:
                s.recv(random.choice((1, 16, 200)))
            except (OSError, ssl.SSLError):
                pass
            rst(raaka)
            return 0, {}, b""
        data = b""
        while True:
            try:
                x = s.recv(65536)
            except ssl.SSLError as e:
                # tlssrv sulkee ilman close_notifya
                if "EOF" in str(e) or "UNEXPECTED" in str(e):
                    break
                raise
            if not x:
                break
            data += x
    finally:
        try:
            s.close()
        except OSError:
            pass
    paa, _, runko = data.partition(b"\r\n\r\n")
    rivit = paa.decode("latin-1").split("\r\n")
    if not rivit or not rivit[0].startswith("HTTP/"):
        raise IOError("ei HTTP-vastausta: %r" % data[:120])
    status = int(rivit[0].split()[1])
    ots = {}
    for r in rivit[1:]:
        k, _, v = r.partition(":")
        ots[k.strip().lower()] = v.strip()
    return status, ots, runko


class WSS:
    """Roomin /account-WebSocket TLS:n yli (roomfront -> roomhttp -> etherws -> accountd)."""

    def __init__(self, portti, aikaraja=120):
        self.s, self.raaka = yhdista(portti, True, aikaraja)
        key = base64.b64encode(os.urandom(16)).decode()
        h = ("GET /account HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
             "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\nOrigin: %s\r\n\r\n" % (key, ORIGIN))
        self.s.sendall(h.encode())
        r = b""
        while b"\r\n\r\n" not in r:
            x = self.s.recv(1)
            if not x:
                break
            r += x
        self.status = r.split(b"\r\n")[0].decode("latin-1")
        if " 101 " not in self.status:
            self.close()
            raise IOError("WebSocket: %s" % self.status)

    def send(self, text):
        d = text.encode()
        n = len(d)
        h = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack(">H", n))
        m = os.urandom(4)
        self.s.sendall(h + m + bytes(c ^ m[i % 4] for i, c in enumerate(d)))

    def _n(self, n):
        b = b""
        while len(b) < n:
            x = self.s.recv(n - len(b))
            if not x:
                raise EOFError("WebSocket päättyi")
            b += x
        return b

    def text(self):
        while True:
            b0, b1 = self._n(2)
            n = b1 & 0x7f
            if n == 126:
                n = struct.unpack(">H", self._n(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._n(8))[0]
            d = self._n(n)
            if b0 & 0x0f == 8:
                raise EOFError("WebSocket close")
            if b0 & 0x0f == 1:
                return d.decode()

    def ask(self, line):
        self.send(line)
        return self.text()

    def close(self, katkaise=False):
        if katkaise:
            rst(self.raaka)
            return
        try:
            self.s.close()
        except OSError:
            pass


class Passkey:
    """Ohjelmistopasskey (P-256), kuten tools/test/accounts."""

    def __init__(self):
        self.key = ec.generate_private_key(ec.SECP256R1())
        self.rawid = os.urandom(16)
        self.id = b64u(self.rawid)

    def cose(self):
        n = self.key.public_key().public_numbers()
        return (bytes([0xa5, 0x01, 0x02, 0x03, 0x26, 0x20, 0x01, 0x21, 0x58, 0x20]) + n.x.to_bytes(32, "big")
                + bytes([0x22, 0x58, 0x20]) + n.y.to_bytes(32, "big"))

    def authdata(self, at=False):
        a = hashlib.sha256(RP.encode()).digest() + bytes([0x05 | (0x40 if at else 0)]) + struct.pack(">I", 0)
        if at:
            a += bytes(16) + struct.pack(">H", len(self.rawid)) + self.rawid + self.cose()
        return a


def clientdata(tyyppi, chal):
    return json.dumps({"type": tyyppi, "challenge": chal, "origin": ORIGIN, "crossOrigin": False}).encode()


def png(koko):
    """Kelvollinen PNG, jonka koko on noin koko tavua (satunnainen, ei pakkaudu)."""
    leveys = 256
    korkeus = max(1, koko // (leveys * 3 + 1))
    raaka = b"".join(b"\0" + os.urandom(leveys * 3) for _ in range(korkeus))

    def pala(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + pala(b"IHDR", struct.pack(">IIBBBBB", leveys, korkeus, 8, 2, 0, 0, 0))
            + pala(b"IDAT", zlib.compress(raaka, 0)) + pala(b"IEND", b""))


class Kayttaja:
    """Room-käyttäjä: passkey, istunto ja jäsenyydet."""

    def __init__(self, testi, nimi):
        self.t = testi
        self.nimi = nimi
        self.pk = Passkey()
        self.token = None
        self.huoneet = []
        self.omat = {}          # huone -> omat viestit (seq)
        self.lukko = threading.Lock()

    def enroll(self, kutsu):
        st, _, b = pyynto(self.t.https, "POST", "/room/api/enroll", otsakkeet=self.t.post_otsakkeet(),
                          runko=json.dumps({"invite": kutsu, "name": self.nimi}).encode())
        if st != 200:
            raise IOError("enroll %s: %d %s" % (self.nimi, st, b[:200]))
        koodi = json.loads(b)["invite"]
        w = WSS(self.t.https)
        try:
            r = w.ask("challenge enroll " + koodi)
            if not r.startswith("challenge "):
                raise IOError("enroll-haaste: " + r)
            chal = r.split(" ")[1]
            a = self.pk.authdata(at=True)
            r = w.ask("enroll %s %s %s %s -" % (koodi, self.pk.id, b64u(a),
                                               b64u(clientdata("webauthn.create", chal))))
        finally:
            w.close()
        if not r.startswith("ok "):
            raise IOError("enroll %s: %s" % (self.nimi, r))
        self.token = r.split(" ")[1]

    def login(self):
        w = WSS(self.t.https)
        try:
            r = w.ask("challenge login")
            if not r.startswith("challenge "):
                raise IOError("login-haaste: " + r)
            a = self.pk.authdata()
            cl = clientdata("webauthn.get", r.split(" ")[1])
            sig = self.pk.key.sign(a + hashlib.sha256(cl).digest(), ec.ECDSA(hashes.SHA256()))
            r = w.ask("login %s %s %s %s -" % (self.pk.id, b64u(a), b64u(cl), b64u(sig)))
        finally:
            w.close()
        if not r.startswith("ok "):
            raise IOError("login %s: %s" % (self.nimi, r))
        f = r.split(" ")
        self.token = f[1]
        if len(f) > 2:
            self.nimi = f[2]

    def api(self, metodi, polku, runko=b"", tyyppi=None, katkaisu=None, aikaraja=120):
        """Roomin API istunnolla; 401 kirjaa uudelleen sisään (rename, vanhentunut istunto) kerran."""
        for yritys in (0, 1):
            ots = {"Cookie": "p2session=%s" % self.token}
            if metodi == "POST":
                ots.update(self.t.post_otsakkeet())
                if tyyppi:
                    ots["Content-Type"] = tyyppi
            st, h, b = pyynto(self.t.https, metodi, "/room" + polku, otsakkeet=ots, runko=runko,
                              katkaisu=katkaisu, aikaraja=aikaraja)
            if st == 401 and yritys == 0:
                self.login()
                continue
            return st, b
        return st, b


