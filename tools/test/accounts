                tk.ok("selain (%s): kutsu pois osoitteesta" % mika, "invite" not in cdp.js("location.href"))
            creds = cdp.call("WebAuthn.getCredentials", authenticatorId=sisa)["credentials"]
            tk.ok("selain (%s): passkey sisäisessä autentikaattorissa, rp localhost" % mika,
                  len(creds) == 1 and creds[0].get("rpId") == RP and creds[0].get("isResidentCredential"), creds)
            odota("document.querySelectorAll('#creds li').length == 1", "lista: yksi passkey")
