            # toinen passkey turva-avaimeen
            ulko = cdp.call("WebAuthn.addVirtualAuthenticator", options={
                "protocol": "ctap2", "ctap2Version": "ctap2_1", "transport": "usb",
                "hasResidentKey": True, "hasUserVerification": True, "isUserVerified": True,
                "hasPrf": prf, "automaticPresenceSimulation": True})["authenticatorId"]
            cdp.js("document.getElementById('addlabel').value = 'avain'")
            klikkaa('#account button[data-hint="security-key"]')
            if odota("document.querySelectorAll('#creds li').length == 2", "toinen passkey"):
                tk.ok("selain (%s): toinen passkey turva-avaimeen" % mika, True)
            c2 = cdp.call("WebAuthn.getCredentials", authenticatorId=ulko)["credentials"]
            tk.ok("selain (%s): passkey usb-autentikaattorissa" % mika, len(c2) == 1, c2)
            # sama laite uudelleen: excludeCredentials estää
            klikkaa('#account button[data-hint="client-device"]')
            odota("document.getElementById('status').className == 'bad'", "sama laite uudelleen estetään", 30)
            tk.ok("selain (%s): sama laite uudelleen estetään" % mika,
                  cdp.js("document.querySelectorAll('#creds li').length") == 2, tila())
            # asuser selaimen istunnolla
            ev = cdp.call("Network.getCookies", urls=["http://localhost:%d/" % self.httpportti])["cookies"]
            tok = [c["value"] for c in ev if c["name"] == "p2session"]
            tk.ok("selain (%s): istuntoeväste SameSite=Strict" % mika,
                  len(tok) == 1 and [c for c in ev if c["name"] == "p2session"][0].get("sameSite") == "Strict", ev)
            if tok:
                t = self.aja("auth/asuser cat /dev/user", stdin=(tok[0] + "\n").encode(), aikaraja=60)
                tk.ok("selain (%s): asuser selaimen istunnolla -> %s" % (mika, nimi), t.stdout.strip() == nimi, t)
            # poisto
            cdp.call("Runtime.evaluate", expression="Array.from(document.querySelectorAll('#creds li'))"
                     ".find((li) => li.textContent.includes('avain')).querySelector('button').click()",
                     userGesture=True)
            if odota("document.querySelectorAll('#creds li').length == 1", "poisto"):
                tk.ok("selain (%s): passkey poistettu" % mika, True)
            tk.ok("selain (%s): sivulla ei virheitä" % mika, not any("EXCEPTION" in x for x in cdp.log), cdp.log)
            # kirjautuminen jäljellä olevalla toimii edelleen (turva-avain irrotettu)
            cdp.call("WebAuthn.removeVirtualAuthenticator", authenticatorId=ulko)
            cdp.call("Network.clearBrowserCookies")
            cdp.call("Page.navigate", url="http://localhost:%d/" % self.httpportti)
            odota("!document.getElementById('signin').hidden", "kirjautumissivu 2")
            klikkaa('#signin button[data-hint="client-device"]')
            ok1 = odota("document.getElementById('status').textContent.startsWith('Signed in as')", "kirjautuminen 2")
            if ok1:
                tk.ok("selain (%s): kirjautuminen jäljellä olevalla passkeylla" % mika, True)
        finally:
            chrome.kill()
            chrome.wait()
            shutil.rmtree(profiili, ignore_errors=True)

    def aja_kaikki(self):
        try:
            self.http_kayntiin()
            self.kaynnista()
            self.kaanna()
            self.palvelut()
            self.protokolla()
            self.ethernetd()
            self.asuser()
            for prf in (True, False):
                self.selain(prf)
        except (vm9.VirheVM, cpuvieras.Siirtovirhe, cpuvieras.Aikaraja) as e:
            self.tk.ok("ajo keskeytyi", False, e)
        finally:
            try:
                if self.v:
