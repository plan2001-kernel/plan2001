    # --- isännän HTTP: sivu ja /account läpi ---

    def http_kayntiin(self):
        sivut = {"/": "account.html", "/account.html": "account.html", "/account.js": "account.js"}
        hak = os.path.join(JUURI, "sys", "lib", "accounts")
        testi = self

        class K(socketserver.BaseRequestHandler):
            def handle(self):
                s = self.request
                h = b""
                while b"\r\n\r\n" not in h:
                    x = s.recv(4096)
                    if not x:
                        return
                    h += x
                rivi = h.split(b"\r\n")[0].decode("latin-1").split(" ")
                polku = urllib.parse.urlparse(rivi[1]).path if len(rivi) > 1 else "/"
                if polku == "/account":
                    portti = testi.v.portit[testi.wsportti]
                    u = socket.create_connection(("127.0.0.1", portti))
                    u.sendall(h)

                    def putki(a, b):
                        try:
                            while True:
                                d = a.recv(65536)
                                if not d:
                                    break
                                b.sendall(d)
                        except OSError:
                            pass
                        for x in (a, b):
                            try:
                                x.shutdown(socket.SHUT_RDWR)
                            except OSError:
                                pass
                    t = threading.Thread(target=putki, args=(u, s), daemon=True)
                    t.start()
                    putki(s, u)
                    t.join(5)
                    return
                if polku not in sivut:
                    s.sendall(b"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                    return
                d = open(os.path.join(hak, sivut[polku]), "rb").read()
                tyyppi = "text/html" if sivut[polku].endswith(".html") else "text/javascript"
                s.sendall(("HTTP/1.1 200 OK\r\nContent-Type: %s; charset=utf-8\r\nContent-Length: %d\r\n"
                           "Cache-Control: no-store\r\nConnection: close\r\n\r\n" % (tyyppi, len(d))).encode() + d)

        class S(socketserver.ThreadingMixIn, socketserver.TCPServer):
            daemon_threads = True
            allow_reuse_address = True

        self.wsportti = WSPORTTI
        self.http = S(("127.0.0.1", 0), K)
        self.httpportti = self.http.server_address[1]
        threading.Thread(target=self.http.serve_forever, daemon=True).start()

    # --- protokolla ohjelmistopasskeylla ---

    def ws(self, origin=None, portti=None):
        return WS(portti or self.httpportti, origin if origin is not None else self.origin)

    def haaste(self, w, line):
        r = w.ask(line)
        if not r.startswith("challenge "):
            return None, r
        return r.split(" "), r

    def enroll(self, pk, koodi, flags=0x05, rp=RP, tyyppi="webauthn.create", origin=None, chal=None, at=True,
               idlle=None, label="-", w=None, haaste=True, portti=None):
        oma = w is None
        w = w or self.ws(portti=portti)
        try:
            if haaste:
                f, r = self.haaste(w, "challenge enroll " + koodi)
                if f is None:
                    return r
                c = f[1]
            else:
                c = b64u(os.urandom(32))
            a = pk.authdata(rp, flags, 0, at=at, idlle=idlle)
            cl = client(tyyppi, chal or c, origin or self.origin)
            return w.ask("enroll %s %s %s %s %s" % (koodi, pk.id, b64u(a), b64u(cl), label))
        finally:
            if oma:
                w.close()

    def login(self, pk, count=None, flags=0x05, rp=RP, allekirjoittaja=None, id=None, kahva="-", at=False,
              tyyppi="webauthn.get", w=None):
        oma = w is None
        w = w or self.ws()
        try:
            f, r = self.haaste(w, "challenge login")
            if f is None:
                return r
            if count is None:
                if pk.laskuri:
                    pk.count += 1
                count = pk.count
            elif pk.laskuri:
                pk.count = max(pk.count, count)
            a = pk.authdata(rp, flags, count, at=at)
            cl = client(tyyppi, f[1], self.origin)
            sig = (allekirjoittaja or pk).key.sign(a + hashlib.sha256(cl).digest(), ec.ECDSA(hashes.SHA256()))
            return w.ask("login %s %s %s %s %s" % (id or pk.id, b64u(a), b64u(cl), b64u(sig), kahva))
        finally:
            if oma:
                w.close()

    def add(self, tok, pk, label="-"):
        w = self.ws()
        try:
            f, r = self.haaste(w, "challenge add " + tok)
            if f is None:
                return r, []
            a = pk.authdata(RP, 0x05, 0, at=True)
            cl = client("webauthn.create", f[1], self.origin)
            return w.ask("add %s %s %s %s %s" % (tok, pk.id, b64u(a), b64u(cl), label)), f[4:]
        finally:
            w.close()

    def kysy(self, line):
        w = self.ws()
        try:
            return w.ask(line)
        finally:
            w.close()

    def odota(self, nimi, saatu, alku):
        return self.tk.ok(nimi, saatu.startswith(alku), saatu)

