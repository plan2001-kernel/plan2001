                        print(self.accountd_loki()[-3000:] if self.tk.virheet else "", end="")
                    except Exception:
                        pass
                    self.v.sammuta()
            finally:
                if self.v:
                    self.v.siivoa()
                if self.http:
                    self.http.shutdown()
                if not self.a.keep:
                    shutil.rmtree(self.tyo, ignore_errors=True)


