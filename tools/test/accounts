                                   "--remote-debugging-port=0", "--window-size=500,800", "about:blank"],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        mika = "PRF" if prf else "ei PRF"
        try:
            dt = None
            for _ in range(100):
                try:
                    dt = dt or int(open(os.path.join(profiili, "DevToolsActivePort")).readline())
                    urllib.request.urlopen("http://127.0.0.1:%d/json" % dt)
