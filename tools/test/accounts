    def ethernetd(self):
        """aux/ethernetd:n /auth libwebauthnin päällä: luonti vaatii AT:n, kirjautuminen ennallaan."""
        tk = self.tk

        def auth(rivi):
            w = WS(self.v.portit[WSPORTTI3], self.origin, "/auth")
            try:
                c = w.text()
                if not c.startswith("challenge "):
                    return c
                return w.ask(rivi(c[10:]))
            finally:
                w.close()

        from cryptography.hazmat.primitives import serialization
        pk = Passkey()
        spki = b64u(pk.key.public_key().public_bytes(serialization.Encoding.DER,
                                                     serialization.PublicFormat.SubjectPublicKeyInfo))

        def enroll(at=True, idlle=None):
            return auth(lambda c: "enroll ethinvitation000001 %s %s %s %s" % (
                pk.id, spki, b64u(pk.authdata(RP, 0x05, 0, at=at, idlle=idlle)),
                b64u(client("webauthn.create", c, self.origin))))

        def login(count, flags=0x05):
            def rivi(c):
                a = pk.authdata(RP, flags, count)
                cl = client("webauthn.get", c, self.origin)
                sig = pk.key.sign(a + hashlib.sha256(cl).digest(), ec.ECDSA(hashes.SHA256()))
                return "login %s %s %s %s" % (pk.id, b64u(a), b64u(cl), b64u(sig))
            return auth(rivi)
        self.odota("ethernetd: luonti ilman AT:tä", enroll(at=False), "error no attested credential")
        self.odota("ethernetd: AT:n id ei passkeyn", enroll(idlle=os.urandom(16)), "error not the attested")
        self.odota("ethernetd: luonti kutsulla", enroll(), "ok ")
        self.odota("ethernetd: kutsu kerran", enroll(), "error no such invitation")
        self.odota("ethernetd: kirjautuminen", login(1), "ok ")
        self.odota("ethernetd: sama laskuri", login(1), "error counter not above")
        self.odota("ethernetd: ei UV:tä", login(2, flags=0x01), "error the user not verified")
        self.odota("ethernetd: kirjautuminen 2", login(3), "ok ")

