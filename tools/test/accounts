def b64u(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def unb64u(s):
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


class WS:
    """Sivun WebSocket (maskatut tekstikehykset)."""

    def __init__(self, portti, origin, polku="/account"):
        self.s = socket.create_connection(("127.0.0.1", portti), timeout=60)
        key = base64.b64encode(os.urandom(16)).decode()
        h = "GET %s HTTP/1.1\r\nHost: localhost:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" \
            "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n" % (polku, portti, key)
        if origin:
            h += "Origin: %s\r\n" % origin
        self.s.sendall((h + "\r\n").encode())
        r = b""
        while b"\r\n\r\n" not in r:
            x = self.s.recv(1)
            if not x:
                break
            r += x
        self.status = r.split(b"\r\n")[0].decode("latin-1")

    def send(self, text):
        d = text.encode()
        n = len(d)
        h = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack(">H", n))
        m = os.urandom(4)
        self.s.sendall(h + m + bytes(c ^ m[i % 4] for i, c in enumerate(d)))

    def _n(self, n):
        b = b""
        while len(b) < n:
            x = self.s.recv(n - len(b))
            if not x:
                raise EOFError("yhteys päättyi")
            b += x
        return b

    def text(self):
        while True:
            b0, b1 = self._n(2)
            n = b1 & 0x7f
            if n == 126:
                n = struct.unpack(">H", self._n(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._n(8))[0]
            d = self._n(n)
            if b0 & 0x0f == 8:
                raise EOFError("close")
            if b0 & 0x0f == 1:
                return d.decode()

    def ask(self, line):
        self.send(line)
        return self.text()

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


class Passkey:
    """Ohjelmistopasskey kuten autentikaattorin: P-256, laskuri."""

    def __init__(self, laskuri=False):
        self.key = ec.generate_private_key(ec.SECP256R1())
        self.rawid = os.urandom(16)
        self.id = b64u(self.rawid)
        self.count = 0 if not laskuri else 1
        self.laskuri = laskuri

    def cose(self):
        n = self.key.public_key().public_numbers()
        return (bytes([0xa5, 0x01, 0x02, 0x03, 0x26, 0x20, 0x01, 0x21, 0x58, 0x20]) + n.x.to_bytes(32, "big")
                + bytes([0x22, 0x58, 0x20]) + n.y.to_bytes(32, "big"))

    def authdata(self, rp=RP, flags=0x05, count=0, at=False, idlle=None):
        a = hashlib.sha256(rp.encode()).digest() + bytes([flags | (0x40 if at else 0)]) + struct.pack(">I", count)
        if at:
            cid = idlle if idlle is not None else self.rawid
            a += bytes(16) + struct.pack(">H", len(cid)) + cid + self.cose()
        return a


def client(tyyppi, chal, origin, **lisa):
    d = {"type": tyyppi, "challenge": chal, "origin": origin, "crossOrigin": False}
    d.update(lisa)
    return json.dumps(d, separators=(",", ":")).encode()


