diff --git a/sys/src/9/pc/archacpi.c b/sys/src/9/pc/archacpi.c
index 4fa65c23b189721b6e2c265ec7d2ef785cef9b4a..4d855ea3df722d0d626360e2f72c48c25f61a6d5 100644
--- a/sys/src/9/pc/archacpi.c
