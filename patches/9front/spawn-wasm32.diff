diff --git a/sys/src/cmd/rc/simple.c b/sys/src/cmd/rc/simple.c
index 362b77bddd5b5c8593a0e08b43ca11a6db12272c..898941e49ce507ecc8cf9d0ac59400c87a46e1ee 100644
--- a/sys/src/cmd/rc/simple.c
+++ b/sys/src/cmd/rc/simple.c
@@ -171,6 +171,79 @@ mkargv(word *a)
 	return argv;
 }
 
+#ifdef HAVE_SPAWN
+enum {
+	Maxops	= 64,	/* spawnin kuvaajaoperaatiot: sanaa, parit */
+};
+
+/* doredirin operaatiot spawnille: parit (from, to), from -1 sulkee to:n; -1 jos liikaa */
+static int
+redirops(redir *rp, int *ops, int n)
+{
+	if(rp==0)
+		return n;
+	n = redirops(rp->next, ops, n);
+	if(n < 0 || n+4 > Maxops)
+		return -1;
+	switch(rp->type){
+	case RDUP:
+		ops[n++] = rp->from;
+		ops[n++] = rp->to;
+		break;
+	case ROPEN:
+		if(rp->from==rp->to)
+			break;
+		ops[n++] = rp->from;
+		ops[n++] = rp->to;
+		ops[n++] = -1;
+		ops[n++] = rp->from;
+		break;
+	case RCLOSE:
+		ops[n++] = -1;
+		ops[n++] = rp->to;
+		break;
+	}
+	return n;
+}
+
+/*
+ * Komento omaksi prosessikseen ilman forkia (spawn(2)): execexecin
+ * polkuhaku, ympäristö ja uudelleenohjaukset, mutta lapsessa tehtävät
+ * Dup- ja Close-operaatiot annetaan spawnille.  Lapsen pid, tai -1:
+ * silloin execforkexec forkkaa, ja lapsen exec raportoi virheen.
+ */
+int
+execspawn(void)
+{
+	char **argv, *file;
+	int ops[Maxops], n, pid;
+	word *path;
+
+	if(runq->argv->words==0)
+		return -1;
+	if((n = redirops(runq->redir, ops, 0)) < 0)
+		return -1;
+	argv = mkargv(runq->argv->words);
+	Updenv();
+	pid = -1;
+	for(path = searchpath(argv[1], "path"); path && pid < 0; path = path->next){
+		file = makepath(path->word, argv[1]);
+		pid = spawn(file, argv+1, ops, n, RFREND);
+		free(file);
+	}
+	free(argv);
+	return pid;
+}
+
+#else
+/* Only WASM32 provides spawn(2); other ports keep fork/exec. */
+int
+execspawn(void)
+{
+	return -1;
+}
+#endif
