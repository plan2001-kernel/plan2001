@@ -1,5 +1,20 @@
 #include "mem.h"
 
+MODE $64
+
+/*
+ * UEFI-sisääntulo (Plan2001 BootInfo v1): tekstin ensimmäinen tavu, sillä
+ * loader (sys/src/boot/efi/sub.c bootkern()) lataa a.out-tekstin
+ * sisääntulo-osoitteeseen.  Pelkkä hyppy varsinaiseen koodiin
+ * _efi64main<> fyysisessä osoitteessa (firmware kartoittaa muistin
+ * identtisesti): 5 + 2 + 1 tavua, jotta alla olevan multiboot-otsakkeen
+ * 4 tavun tasaus säilyy (tools/native-amd64/build tarkistaa).
+ */
+TEXT _efi64(SB), 1, $-4
+	MOVL	$_efi64main<>-KZERO(SB), AX
+	BYTE	$0xFF; BYTE $0xE0	/* JMP* AX: tavuina, ettei 6l poista täytettä */
+	BYTE	$0x90	/* align */
+
 MODE $32
 
 #define DELAY		BYTE $0xEB; BYTE $0x00	/* JMP .+2 */
@@ -234,6 +249,133 @@ _clearbss:
 
 	CALL	main(SB)
 
+/*
+ * UEFI-sisääntulo (Plan2001 BootInfo v1, sys/include/bootinfo.h): loader
+ * (sys/src/boot/efi/x64.s jump64) hyppää tähän 64-bittisessä tilassa
+ * firmwaren sivutauluilla, RDI = BootInfo-blobin fyysinen osoite,
+ * RSI = 0, keskeytykset pois ja IDT tyhjä, _efi64:n (tekstin alku,
+ * a.out-otsakkeen entry, mkfile: 6l -E_efi64) kautta.  Loader on tarkistanut
+ * (archx64.c archcheck()), että sivutus on 4-tasoinen eivätkä firmwaren
+ * sivutaulut ole alueella CPU0PML4..CPU0END, jonka tämä tyhjentää.
+ * Firmware kartoittaa fyysisen muistin identtisesti, joten tämä koodi
+ * ajetaan fyysisestä osoitteestaan, kunnes CR3 vaihtuu; sen jälkeen
+ * identtinen kartoitus kattaa vain ensimmäiset 2 MB, joissa tämä koodi on.
+ * Muuten sama kuin _warp64 ja _start64v yllä.
+ */
+TEXT _efi64main<>(SB), 1, $-4
+	CLI
+	CLD
+	MOVQ	DI, R13				/* BootInfo: talletetaan BSS:n nollauksen jälkeen */
+
+	MOVL	$_gdtptr64p<>-KZERO(SB), AX
+	MOVL	(AX), GDTR
+
+	MOVL	$SELECTOR(2, SELGDT, 0), AX
+	MOVW	AX, DS
+	MOVW	AX, ES
+	MOVW	AX, FS
+	MOVW	AX, GS
+	MOVW	AX, SS
+
+	/* CS = KESEG (64-bittinen koodi) kaukopaluulla */
+	MOVL	$SELECTOR(KESEG, SELGDT, 0), AX
+	PUSHQ	AX
+	MOVL	$_efi64pt<>-KZERO(SB), AX
+	PUSHQ	AX
+	RETFQ
+
+TEXT _efi64pt<>(SB), 1, $-4
+	/* tyhjennä Mach ja sivutaulut */
+	MOVL	$((CPU0END-CPU0PML4)>>2), CX
+	MOVL	$(CPU0PML4-KZERO), SI
+	MOVL	SI, DI
+	XORL	AX, AX
+	CLD
+	REP;	STOSL
+
+	MOVL	SI, AX				/* PML4 */
+	MOVL	AX, DX
+	ADDL	$(PTEACCESSED|PTEDIRTY|PTSZ|PTEWRITE|PTEVALID), DX	/* PDP at PML4 + PTSZ */
+	MOVL	DX, PML4O(0)(AX)		/* PML4E for double-map */
+	MOVL	DX, PML4O(KZERO)(AX)		/* PML4E for KZERO */
+
+	ADDL	$PTSZ, AX			/* PDP at PML4 + PTSZ */
+	ADDL	$PTSZ, DX			/* PD0 at PML4 + 2*PTSZ */
+	MOVL	DX, PDPO(0)(AX)			/* PDPE for double-map */
+	MOVL	DX, PDPO(KZERO)(AX)		/* PDPE for KZERO */
+
+	ADDL	$PTSZ, DX			/* PD1 */
+	MOVL	DX, PDPO(KZERO+GiB)(AX)
+
+	ADDL	$PTSZ, AX			/* PD0 at PML4 + 2*PTSZ */
+	MOVL	$(PTEACCESSED|PTEDIRTY|PTESIZE|PTEGLOBAL|PTEWRITE|PTEVALID), DX
+	MOVL	DX, PDO(0)(AX)			/* PDE for double-map */
+
+	/*
+	 * map from KZERO to end using 2MB pages; MemMin (memory.c) is in
+	 * BSS, so it is stored only after BSS is cleared (R12)
+	 */
+	ADDL	$PDO(KZERO), AX
+	MOVL	$end-KZERO(SB), CX
+	ADDL	$(PGLSZ(1)-1), CX
+	ANDL	$~(PGLSZ(1)-1), CX
+	MOVL	CX, R12
+	SHRL	$(1*PTSHIFT+PGSHIFT), CX
+efimemloop:
+	MOVL	DX, (AX)
+	ADDL	$PGLSZ(1), DX
+	ADDL	$8, AX
+	LOOP	efimemloop
+
+	MOVQ	SI, CR3				/* load the mmu */
+
+	MOVQ	CR4, AX
+	ANDL	$~0x00000010, AX			/* Page Size */
+	ORL	$0x000000A0, AX			/* Page Global, Phys. Address */
+	MOVQ	AX, CR4
+
+	MOVQ	CR0, DX
+	ANDL	$~0x6000000a, DX
+	ORL	$0x80010000, DX			/* Paging Enable, Write Protect */
+	MOVQ	DX, CR0
+
+	MOVQ	$_efi64v<>(SB), AX
+	JMP*	AX
+
+TEXT _efi64v<>(SB), 1, $-4
+	MOVQ	$_gdtptr64v<>(SB), AX
+	MOVL	(AX), GDTR
+
+	XORQ	AX, AX
+	MOVW	AX, DS				/* not used in long mode */
+	MOVW	AX, ES				/* not used in long mode */
+	MOVW	AX, FS
+	MOVW	AX, GS
+	MOVW	AX, SS				/* not used in long mode */
+
+	MOVW	AX, LDTR
+
+	MOVQ	$(CPU0MACH+MACHSIZE), SP
+	MOVQ	$(CPU0MACH), RMACH
+	MOVQ	AX, RUSER			/* up = 0; */
+
+	MOVQ	$edata(SB), DI
+	MOVQ	$end(SB), CX
+	SUBQ	DI, CX				/* end-edata bytes */
+	SHRQ	$2, CX				/* end-edata doublewords */
+
+	CLD
+	REP;	STOSL				/* clear BSS */
+
+	MOVQ	R13, bootinfopa(SB)		/* pc64/bootarch.c */
+	MOVL	R12, MemMin(SB)			/* see memory.c */
+
+	PUSHQ	AX				/* clear flags */
+	POPFQ
+
+	CALL	main(SB)
+	JMP	idle(SB)
+
