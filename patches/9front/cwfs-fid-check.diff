+/*
+ * fid-ketjun tarkistus: flist[]:n ja File.nextin osoittimien on oltava
+ * nil tai files[]:n alkio.  Muu arvo on muistin ylikirjoitus: tulostetaan
+ * arvo, ketju, edellinen File ja sen ympäristö konsoliin (kmesg), sanan
+ * sivu ja sana uudelleen luettuna kullakin suorittimella, ja
+ * pysähdytään abortiin, jolloin prosessi jää Broken-tilaan tutkittavaksi
+ * (acid PID kbdfs:n pelastusshellistä).  Kutsutaan flock pidettynä,
+ * paitsi cw.c:n rewalk(), joka käy ketjut dumpin aikana ilman sitä.
+ */
+int
+fileok(File *f)
+{
+	uintptr o;
+
+	if(f == nil)
+		return 1;
+	if((uintptr)f < (uintptr)files || (uintptr)f >= (uintptr)(files+conf.nfile))
+		return 0;
+	o = (uintptr)f - (uintptr)files;
+	return o % sizeof(File) == 0;
+}
+
+static void
+dumpwords(char *what, void *a, int n)
+{
+	uvlong *w;
+	int i;
+
+	w = (uvlong*)((uintptr)a & ~(uintptr)7);
+	fprint(2, "cwfs: %s %#p:\n", what, w);
+	for(i = 0; i < n/8; i++)
+		fprint(2, "%s%.16llux%s", i%4 == 0 ? "  " : " ", w[i], i%4 == 3 ? "\n" : "");
+	if(i%4 != 0)
+		fprint(2, "\n");
+}
+
+/* sana uudelleen muistista: volatile, ettei kääntäjä käytä aiempaa lukua */
+static uvlong
+reread(void *a)
+{
+	return *(volatile uvlong*)a;
+}
+
+/*
+ * suorittimien määrä #c/sysstatin riveistä; 1, jos sitä ei saa luettua.
+ * Laitepolut (#c, #p), koska cwfs ajetaan bootfs:n nimiavaruudessa.
+ */
+static int
+nmach(void)
+{
+	char buf[4096];
+	int fd, n, i, c;
+
+	if((fd = open("#c/sysstat", OREAD)) < 0)
+		return 1;
+	n = read(fd, buf, sizeof buf);
+	close(fd);
+	c = 0;
+	for(i = 0; i < n; i++)
+		if(buf[i] == '\n')
+			c++;
+	return c > 0 ? c : 1;
+}
+
+/*
+ * Sana a luetaan jokaisella suorittimella: prosessi kiinnitetään
+ * (/proc/N/ctl wired) vuorotellen kuhunkin, ja se lukee sanan kolmesti
+ * 20 ms:n välein.  Erottaa, muuttuiko muisti oikeasti (sama arvo kaikilla
+ * suorittimilla) vai näkikö yksi suoritin väärän sivun (#56).
+ */
+static void
+rereadall(void *a)
+{
+	char name[64];
+	int fd, c, nm, i;
+
+	snprint(name, sizeof name, "#p/%d/ctl", getpid());
+	if((fd = open(name, OWRITE)) < 0){
+		fprint(2, "cwfs: %s: %r\n", name);
+		return;
+	}
+	nm = nmach();
+	for(c = 0; c < nm; c++){
+		if(fprint(fd, "wired %d", c) < 0){
+			fprint(2, "cwfs: wired %d: %r\n", c);
+			continue;
+		}
+		sleep(1);	/* kiinnitys tulee voimaan seuraavassa ajoituksessa */
+		for(i = 0; i < 3; i++){
+			fprint(2, "cwfs: cpu %d read %d: %#.16llux\n", c, i, reread(a));
+			sleep(20);
+		}
+	}
+	close(fd);
+}
+
+void
+badchain(char *where, int h, File *prev, File *f)
+{
+	File **np;
+	uvlong now;
+
+	/* ketjun sana luetaan uudelleen heti, ennen hidasta konsolitulostusta */
+	np = prev != nil ? &prev->next : &flist[h];
+	now = reread(np);
+	fprint(2, "cwfs: %s: corrupt fid chain flist[%d] (%#p): %#p after %#p; files %#p-%#p size %d\n",
+		where, h, &flist[h], f, prev, files, files+conf.nfile, sizeof(File));
+	fprint(2, "cwfs: chain word %#p: seen %#p now %#.16llux pid %d\n", np, f, now, getpid());
+	if(prev != nil){
+		fprint(2, "cwfs: prev: index %lld fid %lud cp %#p qid %llux open %d\n",
+			(vlong)(prev - files), prev->fid, prev->cp, (uvlong)prev->qid.path, prev->open);
+		dumpwords("around prev", (uchar*)prev - 128, sizeof(File) + 256);
+	} else
+		dumpwords("around flist[h]", &flist[h] - 8, 17*8);
+	/* koko sivu: cwfs:n omaa dataa vai vierasta (toisen prosessin tai laitteen) */
+	dumpwords("page of chain word", (void*)((uintptr)np & ~(uintptr)4095), 4096);
+	rereadall(np);
+	abort();
+}
