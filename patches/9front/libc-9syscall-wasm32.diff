--- a/sys/src/libc/9syscall/mkfile
+++ b/sys/src/libc/9syscall/mkfile
@@ -2,11 +2,26 @@
 </$objtype/mkfile
 
 install:V:
-	SYS=`{sed '/^#define._X[123]/d; s/#define.([A-Z0-9_]*).*/\1/' sys.h}
+	SYS=`{rc ./syscalls $objtype sys.h | awk '$1 !~ /^_X[123]$/ {print $1}'}
 	for(I in $SYS) {
 		i=`{echo $I|tr A-Z a-z}
 		n=`{sed -n '/[ 	]'$I'[ 	]/s/.*	//p' sys.h}
 		if(~ $i (exits nsec)) i=_$i
+		if(~ $objtype wasm32){
+			# no system call instruction: the platform's _trap, the
