+			{
+				echo 'typedef long long vlong;'
+				echo 'extern vlong _trap(int, void*);'
+				echo 'vlong'
+				echo $i'(void *a)'
+				echo '{'
+				echo '	return _trap('$n', &a);'
+				echo '}'
+			} > $i.c
+			$CC $CFLAGS $i.c
+		}
+		if not {
 		{switch($objtype){
 		case 68000 68020
 			echo TEXT $i'(SB)', 1, '$0'
@@ -147,8 +162,16 @@
 			echo RET
 		}} > $i.s
 		$AS $i.s
+		}
+	}
+	# A native rebuild must not keep an old wasm-only member or object.
+	if(! ~ $objtype wasm32){
+		rm -f spawn.$O spawn.s
+		if(ar t /$objtype/lib/libc.a >[2]/dev/null | grep -s '^spawn\.'^$O^'$')
+			ar d /$objtype/lib/libc.a spawn.$O >[2]/dev/null
 	}
 	ar vu /$objtype/lib/libc.a *.$O
+	if(~ $objtype wasm32) rm -f *.c
 	rm -f *.$O *.s
 
 nuke clean:V:
