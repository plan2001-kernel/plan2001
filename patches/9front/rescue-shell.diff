+/*
+ * Pelastusshell sarjakonsolilla: ^T^T r käynnistää rc:n kbdfs:n omassa
+ * nimiavaruudessa, joka on kopio käynnistyksen nimiavaruudesta (bootfs
+ * muistissa, #c, #p, #s).  Se ei tarvitse juuritiedostopalvelinta, joten
+ * sillä voi tutkia jumittunutta tai kaatunutta cwfs:ää (ps, acid, /proc,
+ * /srv/cwfs.cmd).  Pelastustilassa sarjalinjan rivit menevät rc:lle eivätkä
+ * consiin; kbdfs kaiuttaa ja muokkaa rivin itse ja kirjoittaa #c/cons:iin.
+ * DEL keskeyttää, ^D antaa EOF:n kuten konsolilla.  Kun rc päättyy (exit
+ * tai ^D), linja palaa consille.
+ */
+enum {
+	Kctlt	= 0x14,		/* ^T */
+};
+
+int rescuefd = -1;	/* rc:n syöte (putki) */
+int rescueout = -1;	/* #c/cons: kaiku */
+int rescuepid;
+int rescuegen;		/* pelastusshellin järjestysnumero */
+int rescuedone;		/* rescuegen:n rc on päättynyt */
+char rescueline[256];
+int nrescue;
+
+static int
+rescuenote(void*, char *msg)
+{
+	/* rc on päättynyt: putken toinen pää on suljettu */
+	return strstr(msg, "write on closed pipe") != nil;
+}
+
+static void
+rescueend(void)
+{
+	close(rescuefd);
+	rescuefd = -1;
+	close(rescueout);
+	rescueout = -1;
+	nrescue = 0;
+}
+
+/*
+ * Vahtii rc:n päättymistä: kun putken toinen pää suljetaan, luku palauttaa
+ * nollan.  rc ei kirjoita syötteeseensä, joten muuta ei tule.
+ */
+static void
+rescuewatch(void *a)
+{
+	int fd, gen;
+	char b[64];
+
+	gen = rescuegen;
+	fd = (int)(uintptr)a;
+	threadsetname("rescuewatch");
+	while(read(fd, b, sizeof b) > 0)
+		;
+	close(fd);
+	if(gen != rescuegen)
+		return;
+	rescuedone = 1;
+	/* seuraava merkki menee jo consille */
+	if((fd = open("#c/cons", OWRITE)) >= 0){
+		fprint(fd, "kbdfs: rescue shell ended\n");
+		close(fd);
+	}
+}
+
+static void
+rescuestart(void)
+{
+	int p[2], fd, pid;
+
+	if((fd = open("#c/cons", OWRITE)) < 0)
+		return;
+	if(pipe(p) < 0){
+		close(fd);
+		return;
+	}
+	switch(pid = rfork(RFPROC|RFFDG|RFNAMEG|RFENVG|RFNOTEG|RFNOWAIT)){
+	case -1:
+		close(p[0]);
+		close(p[1]);
+		close(fd);
+		return;
+	case 0:
+		dup(p[1], 0);
+		dup(fd, 1);
+		dup(fd, 2);
+		for(fd = 3; fd < 100; fd++)
+			close(fd);
+		putenv("prompt", "rescue# ");
+		execl("/bin/rc", "rc", "-i", nil);
+		_exits("rescue: no /bin/rc");
+	}
+	close(p[1]);
+	rescuefd = p[0];
+	rescueout = fd;
+	rescuepid = pid;
+	nrescue = 0;
+	rescuegen++;
+	rescuedone = 0;
+	if((fd = dup(rescuefd, -1)) >= 0)
+		proccreate(rescuewatch, (void*)(uintptr)fd, STACK);
+	fprint(rescueout, "\nkbdfs: rescue shell %d (bootfs namespace; exit ends it)\n", pid);
+}
+
+/* pelastustilan syöterune: rivin muokkaus ja kaiku kuten lineproc */
+static void
+rescuerune(Rune r)
+{
+	char buf[UTFmax];
+	int n;
+
+	switch(r){
+	case Kdel:
+		postnote(PNGROUP, rescuepid, "interrupt");
+		nrescue = 0;
+		fprint(rescueout, "\n");
+		return;
+	case Kbs:
+		if(nrescue > 0){
+			/* edellinen rune, ei tavu */
+			do
+				nrescue--;
+			while(nrescue > 0 && (rescueline[nrescue] & 0xC0) == 0x80);
+			fprint(rescueout, "\b");
+		}
+		return;
+	case Knack:
+		nrescue = 0;
+		fprint(rescueout, "\n");
+		return;
+	case Keof:
+		/* rivi sellaisenaan; tyhjänä nollan mittainen kirjoitus = EOF */
+		break;
+	case '\n':
+		if(nrescue < sizeof rescueline)
+			rescueline[nrescue++] = '\n';
+		fprint(rescueout, "\n");
+		break;
+	default:
+		n = runetochar(buf, &r);
+		if(nrescue + n >= sizeof rescueline)
+			return;
+		memmove(rescueline+nrescue, buf, n);
+		nrescue += n;
+		write(rescueout, buf, n);
+		return;
+	}
+	/* rivi valmis (\n tai ^D) */
+	if(write(rescuefd, rescueline, nrescue) != nrescue)
+		rescueend();
+	else
+		nrescue = 0;
+}
+
 /*
  * Read characters from consfd (serial console)
- */ 
+ */
 void
 consproc(void *)
 {
 	char *p, *e, *x, buf[64];
-	int n, cr;
+	int n, cr, ctlt;
 	Rune r;
 
 	threadsetname("consproc");
+	threadnotify(rescuenote, 1);
 
+	ctlt = 0;
 	cr = 0;
 	p = buf;
 	e = buf + sizeof(buf);
@@ -749,6 +905,26 @@ consproc(void *)
 			}
 			if(cr = (r == '\r'))
 				r = '\n';
+			if(rescuefd >= 0 && rescuedone)
+				rescueend();
+			if(rescuefd >= 0){
+				rescuerune(r);
+				continue;
+			}
+			/* ^T^T r: pelastusshell; muut ^T:t menevät consille */
+			if(r == Kctlt){
+				ctlt++;
+				continue;
+			}
+			if(ctlt >= 2 && r == 'r'){
+				ctlt = 0;
+				rescuestart();
+				continue;
+			}
+			for(; ctlt > 0; ctlt--){
+				Rune t = Kctlt;
+				send(serialchan, &t);
+			}
 			send(serialchan, &r);
 		}
 		if(n < 0) n = 0;
