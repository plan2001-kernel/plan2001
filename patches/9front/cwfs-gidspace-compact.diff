 			return;
 		if(u2->uid == ui->uid)
 			return;
-		if(cons.ngid+ui->ngrp+1 >= conf.gidspace) {
-			print("conf.gidspace too small (%ld)\n", conf.gidspace);
-			return;
-		}
 		for(i = 0; i < ui->ngrp; i++) {
 			if(ui->gtab[i] == u2->uid) {
 				print("member already in group\n");
 				return;
 			}
 		}
+		if(cons.ngid+ui->ngrp+1 >= conf.gidspace)
+			gidcompact();
+		if(cons.ngid+ui->ngrp+1 >= conf.gidspace) {
+			print("conf.gidspace too small (%ld)\n", conf.gidspace);
+			return;
+		}
 
 		wlock(&uidgc.uidlock);
 		s = gidspace+cons.ngid;
