--- a/sys/src/cmd/cwfs/uidgid.c
+++ b/sys/src/cmd/cwfs/uidgid.c
@@ -159,6 +159,39 @@ cmd_newuser(int argc, char *argv[])
 	do_newuser(argc, argv);
 }
 
+/*
+ * adding a member copies the group's table to the end of gidspace
+ * and leaves the old copy behind; deleting one leaves a hole.
+ * pack every group's table to the start of gidspace again, so the
+ * space is not used up until /adm/users is re-read.
+ */
+static void
+gidcompact(void)
+{
+	Userid *t;
+	int i, g;
+
+	t = malloc(conf.gidspace * sizeof(*t));
+	if(t == nil)
+		return;
+	g = 0;
+	for(i = 0; i < cons.nuid; i++) {
+		if(uid[i].ngrp > 0)
+			memmove(t+g, uid[i].gtab, uid[i].ngrp*sizeof(*t));
+		g += uid[i].ngrp;
+	}
+	wlock(&uidgc.uidlock);
+	memmove(gidspace, t, g*sizeof(*t));
+	g = 0;
+	for(i = 0; i < cons.nuid; i++) {
+		uid[i].gtab = gidspace+g;
+		g += uid[i].ngrp;
+	}
+	cons.ngid = g;
+	wunlock(&uidgc.uidlock);
+	free(t);
+}
+
 void
 do_newuser(int argc, char *argv[])
 {
