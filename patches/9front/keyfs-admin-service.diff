diff --git a/sys/src/cmd/auth/keyfs.c b/sys/src/cmd/auth/keyfs.c
index 2cde94b555464a90abd25cc8a2d41e4c799f3b07..9052a7b4f25d1335fb61ac59c9b4ddd88e1e8d46 100644
--- a/sys/src/cmd/auth/keyfs.c
+++ b/sys/src/cmd/auth/keyfs.c
@@ -138,10 +138,39 @@ char 	*(*fcalls[])(Fid*) = {
 static void
 usage(void)
 {
-	fprint(2, "usage: %s [-p] [-r] [-m mtpt] [-w warn] [keyfile]\n", argv0);
+	fprint(2, "usage: %s [-p] [-r] [-m mtpt] [-s srv] [-w warn] [keyfile]\n", argv0);
 	exits("usage");
 }
 
+/* keyfs's attach trusts its caller: access is restricted by the srv file. */
+static void
+publish(char *name, int pipefd)
+{
+	char owner[ANAMELEN], *path;
+	int fd, n;
+
+	fd = open("#c/hostowner", OREAD);
+	if(fd < 0)
+		error("can't read host owner: %r");
+	n = read(fd, owner, sizeof owner-1);
+	close(fd);
+	if(n <= 0)
+		error("can't read host owner");
+	owner[n] = 0;
+	if(strcmp(owner, getuser()) != 0)
+		error("only host owner may publish keyfs");
+	path = smprint("/srv/%s", name);
+	fd = create(path, OWRITE|OCEXEC, 0600);
+	if(fd < 0)
+		error("can't publish %s: %r", path);
+	if(fprint(fd, "%d", pipefd) < 0){
+		remove(path);
+		error("can't post %s: %r", path);
+	}
+	close(fd);
+	free(path);
+}
+
 static int
 haveaeskey(void)
 {
@@ -151,15 +180,21 @@ haveaeskey(void)
 void
 main(int argc, char *argv[])
 {
-	char *mntpt;
+	char *mntpt, *srv;
 	int p[2];
 
 	fmtinstall('W', weirdfmt);
 	mntpt = "/mnt/keys";
+	srv = nil;
 	ARGBEGIN{
 	case 'm':
 		mntpt = EARGF(usage());
 		break;
+	case 's':
+		srv = EARGF(usage());
+		if(*srv == 0 || strchr(srv, '/') != nil || strcmp(srv, ".") == 0 || strcmp(srv, "..") == 0)
+			usage();
+		break;
 	case 'p':
 		usepass = 1;
 		break;
@@ -212,8 +247,17 @@ main(int argc, char *argv[])
 		error("fork");
 	default:
 		close(p[1]);
-		if(mount(p[0], -1, mntpt, MREPL|MCREATE, "") == -1)
+		if(srv != nil)
+			publish(srv, p[0]);
+		if(mount(p[0], -1, mntpt, MREPL|MCREATE, "") == -1){
+			if(srv != nil){
+				char *path;
+				path = smprint("/srv/%s", srv);
+				remove(path);
+				free(path);
+			}
 			error("can't mount: %r");
+		}
 		exits(0);
 	}
 }
