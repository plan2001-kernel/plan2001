--- a/rc/bin/termrc
+++ b/rc/bin/termrc
@@ -96,4 +96,30 @@
 	reform/audio
 }
 
+# serial console: a shell of its own on the serial line, started once and
+# again whenever it ends; not a window of rio's.  bootrc's kbdfs (-c) keeps
+# the line's characters on /srv/cons; this kbdfs reads them raw from there,
+# edits lines, echoes and turns DEL into an interrupt for this note group.
+# The restarting loop is an rc of its own (a forked rc subshell exits on any
+# note it catches, sigint or not) that ignores DEL; the shell has no sigint,
+# so DEL abandons its command line as on any console.  Started after
+# termrc's mounts (dns), which its namespace copies; it marks its kbdfs not
+# killable itself (it runs in the background, so termrc's dontkill below
+# may not see it yet).
+if(! ~ $#console 0 && test -e /srv/cons && ! test -e /env/serialshell){
+	echo -n $console(1) >/env/serialshell
+	@{
+		rfork ens
+		{echo -n rawon >[1=3]; aux/kbdfs -q -m /mnt/serialcons /dev/cons} >[3]/dev/consctl >'#c/cons' >[2=1]
+		dontkill '^kbdfs$'
+		bind /mnt/serialcons/cons /dev/cons
+		bind /mnt/serialcons/consctl /dev/consctl
+		home=/usr/$user
+		prompt=('term% ' '	')
+		fn term% {$*}
+		cd $home
+		exec rc -c 'fn sigint {}; while(){ @{fn sigint; exec rc -i} </dev/cons >/dev/cons >[2=1]; sleep 1 }'
+	} &
+}
+
 dontkill '^(9660srv|cfs|cs|cwfs.*|disk|dns|dossrv|ether|factotum|gefs|hjfs|ipconfig|kb|kfs|mntgen|paqfs|reboot|usbd|venti|wpa)$'
