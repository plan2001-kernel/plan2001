+/* A slow 9P write must not make the editor echo one rune per RTT.  The
+ * bounded queue lets it collect subsequent input while this proc writes.
+ * Program output uses the same queue, with an acknowledgement and errors.
+ */
+static void
+outputproc(void *)
+{
+	Output *o, *pending, *batch[128];
+	char *buf;
+	int n, nb, i, size;
+	char err[ERRMAX];
+
+	threadsetname("console output");
+	size = sizeof echobuf;
+	buf = emalloc9p(size);
+	pending = nil;
+	for(;;){
+		o = pending != nil ? pending : recvp(outchan);
+		pending = nil;
+		n = nb = 0;
+		do {
+			if(n != 0 && n+o->n > size){
+				pending = o;
+				break;
+			}
+			if(o->n > size){
+				size = o->n;
+				buf = erealloc9p(buf, size);
+			}
+			memmove(buf+n, o->p, o->n);
+			n += o->n;
+			batch[nb++] = o;
+			if(nb == nelem(batch) || n == size)
+				break;
+		} while((o = nbrecvp(outchan)) != nil);
+		i = write(1, buf, n);
+		if(i < 0)
+			rerrstr(err, sizeof err);
+		else if(i != n){
+			strecpy(err, err+sizeof err, "short console write");
+			i = -1;
+		}
+		for(n = 0; n < nb; n++){
+			o = batch[n];
+			if(o->ack != nil){
+				if(i < 0)
+					strecpy(o->err, o->err+sizeof o->err, err);
+				else
+					o->err[0] = 0;
+				sendul(o->ack, i);
+			}else{
+				free(o->p);
+				free(o);
+			}
+		}
+	}
+}
+
+static void
+flushout(void)
+{
+	Output *o;
+
+	if(necho == 0)
+		return;
+	o = emalloc9p(sizeof *o);
+	o->p = emalloc9p(necho);
+	memmove(o->p, echobuf, necho);
+	o->n = necho;
+	o->ack = nil;
+	sendp(outchan, o);
+	necho = 0;
+}
+
+static void
+echoout(char *s, int n)
+{
+	if(necho+n > sizeof echobuf)
+		flushout();
+	memmove(echobuf+necho, s, n);
+	necho += n;
+}
+
+/* Erase cells explicitly: BS alone only moves a terminal's cursor. */
+static void
+erasecells(int n)
+{
+	char b[80];
+	int m;
+
+	while(n-- > 0){
+		if(termcol == 0){
+			echoout("\033[A", 3);
+			termcol = termcols;
+		}
+		termcol--;
+		m = snprint(b, sizeof b, "\033[%dG \033[%dG", termcol+1, termcol+1);
+		echoout(b, m);
+	}
+}
+
+#include "termwidth.h"
+
+/* Track the ordinary console output too, so a tab after rc's prompt has
+ * the same tab stop as the terminal.  Escape sequences don't occupy cells.
+ */
+static void
+consolecol(char *p, int n)
+{
+	static char utf[UTFmax];
+	static int nu, esc;
+	Rune r;
+	int w;
+
+	while(n-- > 0){
+		if(esc){
+			if(esc == 1 && *p == '[')
+				esc = 2;
+			else if(esc == 1 || (*p >= '@' && *p <= '~'))
+				esc = 0;
+			p++;
+			continue;
+		}
+		utf[nu++] = *p++;
+		if(!fullrune(utf, nu))
+			continue;
+		chartorune(&r, utf);
+		nu = 0;
+		switch(r){
+		case '\033': esc = 1; break;
+		case '\r': case '\n': termcol = 0; break;
+		case '\b': if(termcol > 0) termcol--; break;
+		case '\t': termcol = (termcol+8)&~7; break;
+		default:
+			w = termwidth(r);
+			if(w > 0){
+				if(termcol+w > termcols)
+					termcol = 0;
+				termcol += w;
+			}
+		}
+	}
+}
+
+/* Return the number of cells to undo, including padding before a wide rune. */
+static int
+echorune(Rune r)
+{
+	char b[UTFmax];
+	int w, pad;
+
+	if(!termcols){
+		echoout(b, runetochar(b, &r));
+		return 1;
+	}
+	if(r == '\n'){
+		echoout("\n", 1);
+		termcol = 0;
+		return 0;
+	}
+	w = r == '\t' ? 8-(termcol%8) : termwidth(r);
+	if(r < ' ' && r != '\t')
+		w = 2;
+	pad = 0;
+	if(w > 0 && termcol == termcols){
+		echoout("\r\n", 2);
+		termcol = 0;
+	}
+	if(r == '\t'){
+		w = 8-(termcol%8);
+		if(w > termcols-termcol)
+			w = termcols-termcol;
+		echoout("        ", w);
+	}else{
+		if(w > 0 && termcol+w > termcols){
+			pad = termcols-termcol;
+			echoout(" ", pad);
+			echoout("\r\n", 2);
+			termcol = 0;
+		}
+		if(r < ' '){
+			b[0] = '^';
+			b[1] = r+'@';
+			echoout(b, 2);
+		}else
+			echoout(b, runetochar(b, &r));
+	}
+	termcol += w;
+	return w+pad;
+}
