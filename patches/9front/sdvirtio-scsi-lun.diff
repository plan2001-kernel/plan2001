+		cmd[0] = 0x12;
+		cmd[4] = 36;
+		memset(buf, 0, 36);
+		vioscsiio(vd, l->target, l->lun, cmd, sizeof(cmd), buf, 36, 0, resp);
+		if(resp[11] == VSbusy || resp[11] == VSreset || resp[11] == VSaborted)
+			continue;
+		if(resp[11] != VSok)
+			return 0;
+		if(resp[10] == SDok)
+			return (buf[0]>>5) == 0 || ((buf[0]>>5) == 1 && (buf[0]&0x1F) != 0x1F);
+		if(resp[10] != SDcheck && resp[10] != SDbusy)
+			return 0;
+	}
+	return 0;
+}
