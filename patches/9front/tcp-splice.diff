diff --git a/sys/src/9/ip/tcp.c b/sys/src/9/ip/tcp.c
index 71a0c6b97bf75f127b50ca2e4d99a89385deca44..c4eef5fc5f6a534c754e63fd7b22862f4c634765 100644
--- a/sys/src/9/ip/tcp.c
