diff --git a/sys/src/9/bcm64/l.s b/sys/src/9/bcm64/l.s
index 7e221047d1bed1cf8136a54e1e807943ae129016..1ed6463235b1b7b59c79cef02ea9d8d14aa3ee30 100644
--- a/sys/src/9/bcm64/l.s
+++ b/sys/src/9/bcm64/l.s
@@ -52,6 +52,12 @@ _zerobss:
 	CMP	R1, R2
 	BNE	_zerobss
 
+#ifdef UEFI
+	/* X0 at entry: BootInfo v1's physical address (uefi.c); BSS is clear */
+	MOV	$bootinfopa-KZERO(SB), R1
+	MOV	R26, (R1)
+#endif
+
 	/* setup page tables */
 	MOV	$(L1BOT-KZERO), R0
 	BL	mmuidmap(SB)
@@ -700,6 +706,41 @@ TEXT vserr(SB), 1, $-4
 _vserrpatch:
 	B	_vserrpatch	// branch to vtrapX() patched in
 
+/*
+ * PSCI and other firmware calls (SMC Calling Convention): X0-X7 from
+ * the Ureg in, X0-X3 back into it.  The UEFI kernel's firmware is TF-A
+ * at EL3 (uefi.c); the device tree's /psci says which conduit.
+ */
+TEXT smccall(SB), 1, $32
+	MOVP	R26, R27, (RSP)
+	MOV	R0, R8
+	MOV	R8, 16(RSP)
+	MOVP	0(R8), R0, R1
+	MOVP	16(R8), R2, R3
+	MOVP	32(R8), R4, R5
+	MOVP	48(R8), R6, R7
+	SMC
+	MOV	16(RSP), R8
+	MOVP	R0, R1, 0(R8)
+	MOVP	R2, R3, 16(R8)
+	MOVP	(RSP), R26, R27
+	RETURN
+
+TEXT hvccall(SB), 1, $32
+	MOVP	R26, R27, (RSP)
+	MOV	R0, R8
+	MOV	R8, 16(RSP)
+	MOVP	0(R8), R0, R1
+	MOVP	16(R8), R2, R3
+	MOVP	32(R8), R4, R5
+	MOVP	48(R8), R6, R7
+	HVC
+	MOV	16(RSP), R8
+	MOVP	R0, R1, 0(R8)
+	MOVP	R2, R3, 16(R8)
+	MOVP	(RSP), R26, R27
+	RETURN
+
 /* fault-proof memcpy */
 TEXT peek(SB), 1, $-4
 	MOV	R0, R1
