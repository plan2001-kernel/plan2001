diff --git a/sys/src/9/bcm64/mem.h b/sys/src/9/bcm64/mem.h
index dacd0ebf6ec9061b3eef541a57d7ed1780ff9d8e..e4d925da47427930bf353f658f1ef5cf7ed9d952 100644
--- a/sys/src/9/bcm64/mem.h
+++ b/sys/src/9/bcm64/mem.h
@@ -59,10 +59,39 @@
 
 #define	KZERO		(0xFFFFFFFFC0000000ULL)	/* kernel address space */
 
-#define SPINTABLE	(KZERO+0xd8)
-#define CONFADDR	(KZERO+0x100)
-#define	REBOOTADDR	(0x1c00)		/* reboot code - physical address */
-#define	VCBUFFER	(KZERO+0x3400)		/* videocore mailbox buffer */
+/*
+ * PHYSBASE: where the kernel's low area and image start in physical
+ * memory.  The Raspberry Pi firmware boots the kernel at 0x80000 with
+ * the CPU spin table at 0xd8 (PHYSBASE 0).  The UEFI kernel (-DUEFI,
+ * CONF=pi4efi) is entered by the Plan2001 EFI loader under TF-A and
+ * EDK2, which keep 0 - 0x400000; it has the same layout PHYSBASE higher.
+ * KZERO still maps physical 0, so PADDR, KADDR and bus addresses are
+ * unchanged.  The loader claims [PHYSBASE, end) (uefi.c checks it).
+ */
+#ifdef UEFI
+#define	PHYSBASE	0x01000000ULL
+#else
+#define	PHYSBASE	0ULL
+#endif
+
+/*
+ * INITMAP: alkukartan osa, jota ../arm64/mmu.c:n kmapram() ei kartoita
+ * uudelleen.  Stock-ydin purkaa julkaisun tapaan KZERO-ikkunan ytimen
+ * 512 MiB:n lohkon yläpuolelta (Pi3:n oheislaitteet 0x3F000000 ovat
+ * ikkunassa, eivät saa jäädä välimuistilliseksi muistiksi) ja kartoittaa
+ * RAM:n uudelleen (mem.c).  UEFI-ydin pitää koko 1 GiB:n ikkunan: loaderin
+ * efibootmap=0,0x40000000, ja BCM2711:n oheislaitteet ovat sen yläpuolella.
+ */
+#ifdef UEFI
+#define	INITMAP		((uintptr)-KZERO)
+#else
+#define	INITMAP		(ROUND((uintptr)end + BY2PG, PGLSZ(1))-KZERO)
+#endif
+
+#define SPINTABLE	(KZERO+PHYSBASE+0xd8)
+#define CONFADDR	(KZERO+PHYSBASE+0x100)
+#define	REBOOTADDR	(PHYSBASE+0x1c00)	/* reboot code - physical address */
+#define	VCBUFFER	(KZERO+PHYSBASE+0x3400)	/* videocore mailbox buffer */
 
 /* temporary identity map for TTBR0 (using only top-level) */
 #define L1BOT		((L1-L1TOPSIZE)&-BY2PG)
@@ -74,7 +103,7 @@
 
 #define MACHADDR(n)	(KTZERO-((n)+1)*MACHSIZE)
 
-#define	KTZERO		(KZERO+0x80000)		/* kernel text start */
+#define	KTZERO		(KZERO+PHYSBASE+0x80000)	/* kernel text start */
 
 #define	UZERO		0ULL			/* user segment */
 #define	UTZERO		(UZERO+0x10000)		/* user text start */
