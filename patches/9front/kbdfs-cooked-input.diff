--- a/sys/src/cmd/aux/kbdfs/kbdfs.c
+++ b/sys/src/cmd/aux/kbdfs/kbdfs.c
@@ -1149,7 +1149,7 @@ ctlproc(void *)
 			case Rawon:
 				if(raw = (c == Rawon)){
 					r = 0;
