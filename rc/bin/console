#!/bin/rc

if(~ $#* 0)
	*=(rc -i)

a=$console(1)
if(! ~ $#a 0){
	if(! ~ $a /* '#'*)
		a=/dev/eia^$a
	if(test -e /dev/kbd){
		# termrc's serial shell has the line: an ordinary window
		if(test -e /env/serialshell)
			exec $* </dev/cons >/dev/cons >[2=1]
		@{rfork ns; aux/kbdfs; exec $* </dev/cons >/dev/cons >[2=1]} | tee $a
		exit
	}
}
aux/kbdfs $a
exec $* </dev/cons >/dev/cons >[2=1]
